/* Additive ODE extensions. The inherited OdeSolve entry point is unchanged. */

OdeExtLegacy(_data) <--
    If(Length(data) = 3, {data[1], data[2]}, {});

RuleBase("OdeExtSeparableParts", {rhs});

10 # OdeExtSeparableParts(_fx * _gy) _
     (IsFreeOf(y, fx) And IsFreeOf(x, gy) And Not(IsFreeOf(y, gy)) And Degree(gy, y) = 1)
     <-- {fx, gy};
11 # OdeExtSeparableParts(_gy * _fx) _
     (IsFreeOf(x, gy) And Not(IsFreeOf(y, gy)) And Degree(gy, y) = 1 And IsFreeOf(y, fx))
     <-- {fx, gy};
12 # OdeExtSeparableParts(_fx / _den) _
     (IsFreeOf(y, fx) And IsFreeOf(x, den) And Not(IsFreeOf(y, den)) And Degree(den, y) = 1)
     <-- {fx, 1 / den};
13 # OdeExtSeparableParts(_num / _den) _
     (IsFreeOf(x, num) And Not(IsFreeOf(y, num)) And Degree(num, y) = 1 And IsFreeOf(y, den))
     <-- {1 / den, num};
20 # OdeExtSeparableParts(_gy) _
     (IsFreeOf(x, gy) And Not(IsFreeOf(y, gy)) And Degree(gy, y) = 1)
     <-- {1, gy};
100 # OdeExtSeparableParts(_rhs) <-- {};

10 # OdeExtSolveSeparable(y' == _rhs) <-- OdeExtLegacy(OdeExtSolveSeparableRhsData(rhs, False));
100 # OdeExtSolveSeparable(_equation) <-- {};
10 # OdeExtSolveSeparableData(y' == _rhs) <-- OdeExtSolveSeparableRhsData(rhs, True);
100 # OdeExtSolveSeparableData(_equation) <-- {};

OdeExtSolveSeparableRhsData(_rhs, _collect) <--
[
    Local(parts, leftIntegral, rightIntegral, constant, solutions, candidate);
    parts := OdeExtSeparableParts(rhs);
    if (Length(parts) != 2) [
        {};
    ] else [
        leftIntegral := Integrate(y) (1 / parts[2]);
        rightIntegral := Integrate(x) parts[1];
        if (Not(IsFreeOf(Integrate, leftIntegral)) Or
            Not(IsFreeOf(Integrate, rightIntegral))) [
            {};
        ] else [
            constant := UniqueConstant();
            solutions := Solve(leftIntegral == rightIntegral + constant, y);
            if (Length(solutions) = 0) [
                {};
            ] else [
                candidate := solutions[1][2];
                /* The host adapter performs the single authoritative OdeTest.
                   Repeating it here is expensive and some nonlinear identities
                   exceed the inherited simplifier's recursion budget. */
                {{candidate}, Separable,
                 If(collect,
                    {{OdeSeparableForm, (1 / parts[2]) * y' == parts[1], 2},
                     {OdeIntegrateBoth, leftIntegral == rightIntegral + constant, 2}},
                    {})};
            ];
        ];
    ];
];

RuleBase("OdeExtSolveLinearFirstOrder", {equation});

10 # OdeExtSolveLinearFirstOrder(y' + _dependentTerm == _rhs) _
     (IsFreeOf(y, rhs) And Degree(dependentTerm, y) = 1) <--
     OdeExtLegacy(OdeExtSolveLinearFirstOrderPartsData(
         Coef(dependentTerm, y, 1),
         rhs - Coef(dependentTerm, y, 0), False));
11 # OdeExtSolveLinearFirstOrder(y' - _dependentTerm == _rhs) _
     (IsFreeOf(y, rhs) And Degree(dependentTerm, y) = 1) <--
     OdeExtLegacy(OdeExtSolveLinearFirstOrderPartsData(
         -Coef(dependentTerm, y, 1),
         rhs + Coef(dependentTerm, y, 0), False));
12 # OdeExtSolveLinearFirstOrder(_dependentTerm + y' == _rhs) _
     (IsFreeOf(y, rhs) And Degree(dependentTerm, y) = 1) <--
     OdeExtLegacy(OdeExtSolveLinearFirstOrderPartsData(
         Coef(dependentTerm, y, 1),
         rhs - Coef(dependentTerm, y, 0), False));
20 # OdeExtSolveLinearFirstOrder(y' == _rhs) _
     (Degree(rhs, y) = 1) <--
     OdeExtLegacy(OdeExtSolveLinearFirstOrderPartsData(-Coef(rhs, y, 1), Coef(rhs, y, 0), False));
100 # OdeExtSolveLinearFirstOrder(_equation) <-- {};

RuleBase("OdeExtSolveLinearFirstOrderData", {equation});
10 # OdeExtSolveLinearFirstOrderData(y' + _dependentTerm == _rhs) _
     (IsFreeOf(y, rhs) And Degree(dependentTerm, y) = 1) <--
     OdeExtSolveLinearFirstOrderPartsData(Coef(dependentTerm, y, 1),
                                         rhs - Coef(dependentTerm, y, 0), True);
11 # OdeExtSolveLinearFirstOrderData(y' - _dependentTerm == _rhs) _
     (IsFreeOf(y, rhs) And Degree(dependentTerm, y) = 1) <--
     OdeExtSolveLinearFirstOrderPartsData(-Coef(dependentTerm, y, 1),
                                         rhs + Coef(dependentTerm, y, 0), True);
12 # OdeExtSolveLinearFirstOrderData(_dependentTerm + y' == _rhs) _
     (IsFreeOf(y, rhs) And Degree(dependentTerm, y) = 1) <--
     OdeExtSolveLinearFirstOrderPartsData(Coef(dependentTerm, y, 1),
                                         rhs - Coef(dependentTerm, y, 0), True);
20 # OdeExtSolveLinearFirstOrderData(y' == _rhs) _
     (Degree(rhs, y) = 1) <--
     OdeExtSolveLinearFirstOrderPartsData(-Coef(rhs, y, 1), Coef(rhs, y, 0), True);
100 # OdeExtSolveLinearFirstOrderData(_equation) <-- {};

OdeExtSolveLinearFirstOrderPartsData(_p, _q, _collect) <--
[
    Local(integratingExponent, integratingFactor, antiderivative,
          constant, candidate);
    if (p = 0 Or Not(IsFreeOf(y, {p, q}))) [
        {};
    ] else [
        integratingExponent := Integrate(x) p;
        integratingFactor := Exp(integratingExponent);
        antiderivative := Integrate(x) Simplify(q * integratingFactor);
        if (Not(IsFreeOf(Integrate, integratingExponent)) Or
            Not(IsFreeOf(Integrate, antiderivative))) [
            {};
        ] else [
            constant := UniqueConstant();
            candidate := Simplify((antiderivative + constant) / integratingFactor);
            {{candidate}, LinearFirstOrder,
             If(collect,
                {{OdeLinearForm, y' + p*y == q, 2},
                 {OdeIntegratingFactor, integratingFactor, 2},
                 {OdeIntegrateLinear, integratingFactor*y == antiderivative + constant, 1}},
                {})};
        ];
    ];
];

RuleBase("OdeExtSolveBernoulli", {equation});

5 # OdeExtSolveBernoulli(y' + y == _q * y^2) _
    (IsFreeOf(y, q)) <-- OdeExtLegacy(OdeExtSolveBernoulliPartsData(1, q, False));
5 # OdeExtSolveBernoulli(y' + y == y^2 * _q) _
    (IsFreeOf(y, q)) <-- OdeExtLegacy(OdeExtSolveBernoulliPartsData(1, q, False));
10 # OdeExtSolveBernoulli(y' + _p * y == _q * y^2) _
     (IsFreeOf(y, {p, q})) <-- OdeExtLegacy(OdeExtSolveBernoulliPartsData(p, q, False));
10 # OdeExtSolveBernoulli(y' + y * _p == _q * y^2) _
     (IsFreeOf(y, {p, q})) <-- OdeExtLegacy(OdeExtSolveBernoulliPartsData(p, q, False));
10 # OdeExtSolveBernoulli(y' + _p * y == y^2 * _q) _
     (IsFreeOf(y, {p, q})) <-- OdeExtLegacy(OdeExtSolveBernoulliPartsData(p, q, False));
10 # OdeExtSolveBernoulli(y' + y * _p == y^2 * _q) _
     (IsFreeOf(y, {p, q})) <-- OdeExtLegacy(OdeExtSolveBernoulliPartsData(p, q, False));
100 # OdeExtSolveBernoulli(_equation) <-- {};

RuleBase("OdeExtSolveBernoulliData", {equation});
5 # OdeExtSolveBernoulliData(y' + y == _q * y^2) _
    (IsFreeOf(y, q)) <-- OdeExtSolveBernoulliPartsData(1, q, True);
5 # OdeExtSolveBernoulliData(y' + y == y^2 * _q) _
    (IsFreeOf(y, q)) <-- OdeExtSolveBernoulliPartsData(1, q, True);
10 # OdeExtSolveBernoulliData(y' + _p * y == _q * y^2) _
     (IsFreeOf(y, {p, q})) <-- OdeExtSolveBernoulliPartsData(p, q, True);
10 # OdeExtSolveBernoulliData(y' + y * _p == _q * y^2) _
     (IsFreeOf(y, {p, q})) <-- OdeExtSolveBernoulliPartsData(p, q, True);
10 # OdeExtSolveBernoulliData(y' + _p * y == y^2 * _q) _
     (IsFreeOf(y, {p, q})) <-- OdeExtSolveBernoulliPartsData(p, q, True);
10 # OdeExtSolveBernoulliData(y' + y * _p == y^2 * _q) _
     (IsFreeOf(y, {p, q})) <-- OdeExtSolveBernoulliPartsData(p, q, True);
100 # OdeExtSolveBernoulliData(_equation) <-- {};

OdeExtSolveBernoulliPartsData(_p, _q, _collect) <--
[
    Local(integratingFactor, antiderivative, constant, transformed, candidate);
    integratingFactor := Exp(-(Integrate(x) p));
    antiderivative := Integrate(x) Simplify(-q * integratingFactor);
    if (Not(IsFreeOf(Integrate, integratingFactor)) Or
        Not(IsFreeOf(Integrate, antiderivative))) [
        {};
    ] else [
        constant := UniqueConstant();
        transformed := Simplify((antiderivative + constant) / integratingFactor);
        candidate := Simplify(1 / transformed);
        /* y=0 is lost by the v=1/y substitution and must remain explicit. */
        {{candidate, 0}, Bernoulli,
         If(collect,
            {{OdeBernoulliForm, y' + p*y == q*y^2, 2},
             {OdeReciprocalSubstitution, v == 1/y, 2},
             {OdeBernoulliLinear, v' - p*v == -q, 2},
             {OdeIntegratingFactor, integratingFactor, 2},
             {OdeRestoreZeroBranch, y == 0, 1}},
            {})};
    ];
];

/* Second-order linear equations with constant coefficients.  The
   undetermined-coefficients extension deliberately accepts only forcing
   families closed under differentiation. */
OdeExtConstantList(_count) <--
[
    Local(result, index);
    result := ZeroVector(count);
    For(index := 1, index <= count, index++)
        result[index] := UniqueConstant();
    result;
];

OdeExtD1(_expression) <-- ApplyPure("D", {x, expression});
OdeExtD2(_expression) <-- ApplyPure("D", {x, OdeExtD1(expression)});

OdeExtApplyAssignments(_expression, _assignments) <--
[
    Local(result, assignment);
    result := expression;
    ForEach(assignment, assignments)
        result := WithValue(assignment[1], assignment[2], result);
    result;
];

OdeExtEulerPower(_exponent) <--
    If(IsInteger(exponent) And exponent < 0, 1/x^(-exponent), x^exponent);

RuleBase("OdeExtExponentialPolynomialParts", {forcing});
10 # OdeExtExponentialPolynomialParts(Exp(_argument)) _
     (Degree(argument, x) = 1 And Coef(argument, x, 0) = 0) <--
     {1, Coef(argument, x, 1)};
20 # OdeExtExponentialPolynomialParts(_polynomial * Exp(_argument)) _
     (CanBeUni(x, polynomial) And Degree(argument, x) = 1 And
      Coef(argument, x, 0) = 0) <--
     {polynomial, Coef(argument, x, 1)};
21 # OdeExtExponentialPolynomialParts(Exp(_argument) * _polynomial) _
     (CanBeUni(x, polynomial) And Degree(argument, x) = 1 And
      Coef(argument, x, 0) = 0) <--
     {polynomial, Coef(argument, x, 1)};
90 # OdeExtExponentialPolynomialParts(_polynomial) _
     CanBeUni(x, polynomial) <-- {polynomial, 0};
100 # OdeExtExponentialPolynomialParts(_forcing) <-- {};

OdeExtUndeterminedExponential(_a, _b, _c, _forcing) <--
[
    Local(parts, polynomial, rate, degree, characteristic,
          characteristicDerivative, resonance, coefficients, base,
          trial, residual, equations, assignments, particular);
    parts := OdeExtExponentialPolynomialParts(forcing);
    if (Length(parts) != 2) [
        {};
    ] else [
        polynomial := parts[1];
        rate := parts[2];
        degree := Degree(polynomial, x);
        characteristic := Simplify(a*rate^2 + b*rate + c);
        characteristicDerivative := Simplify(2*a*rate + b);
        resonance := If(characteristic != 0, 0,
                        If(characteristicDerivative != 0, 1, 2));
        coefficients := OdeExtConstantList(degree + 1);
        base := Add(coefficients * (x^(0 .. degree)));
        trial := Simplify(x^resonance * Exp(rate*x) * base);
        residual := Simplify(
            (a*OdeExtD2(trial) + b*OdeExtD1(trial) + c*trial - forcing) /
            Exp(rate*x));
        if (Not(CanBeUni(x, residual))) [
            {};
        ] else [
            equations := Coef(Expand(residual), x, 0 .. degree);
            equations := Select({{coefficient}, coefficient != 0}, equations);
            assignments := Solve(equations, coefficients);
            if (Length(assignments) != 1) [
                {};
            ] else [
                particular := OdeExtApplyAssignments(trial, assignments[1]);
                If(IsFreeOf(Undefined, particular) And
                   Simplify(a*OdeExtD2(particular) +
                            b*OdeExtD1(particular) + c*particular - forcing) = 0,
                   {particular, trial, equations,
                    a*r^2 + b*r + c == 0},
                   {});
            ];
        ];
    ];
];

RuleBase("OdeExtTrigonometricPolynomialParts", {forcing});
10 # OdeExtTrigonometricPolynomialParts(Sin(_argument)) _
     (Degree(argument, x) = 1 And Coef(argument, x, 0) = 0) <--
     {0, 1, Coef(argument, x, 1)};
11 # OdeExtTrigonometricPolynomialParts(Cos(_argument)) _
     (Degree(argument, x) = 1 And Coef(argument, x, 0) = 0) <--
     {1, 0, Coef(argument, x, 1)};
20 # OdeExtTrigonometricPolynomialParts(_polynomial * Sin(_argument)) _
     (CanBeUni(x, polynomial) And Degree(argument, x) = 1 And
      Coef(argument, x, 0) = 0) <--
     {0, polynomial, Coef(argument, x, 1)};
21 # OdeExtTrigonometricPolynomialParts(Sin(_argument) * _polynomial) _
     (CanBeUni(x, polynomial) And Degree(argument, x) = 1 And
      Coef(argument, x, 0) = 0) <--
     {0, polynomial, Coef(argument, x, 1)};
22 # OdeExtTrigonometricPolynomialParts(_polynomial * Cos(_argument)) _
     (CanBeUni(x, polynomial) And Degree(argument, x) = 1 And
      Coef(argument, x, 0) = 0) <--
     {polynomial, 0, Coef(argument, x, 1)};
23 # OdeExtTrigonometricPolynomialParts(Cos(_argument) * _polynomial) _
     (CanBeUni(x, polynomial) And Degree(argument, x) = 1 And
      Coef(argument, x, 0) = 0) <--
     {polynomial, 0, Coef(argument, x, 1)};
100 # OdeExtTrigonometricPolynomialParts(_forcing) <-- {};

OdeExtUndeterminedTrigonometric(_a, _b, _c, _forcing) <--
[
    Local(parts, cosinePolynomial, sinePolynomial, frequency, degree,
          resonance, cosineCoefficients, sineCoefficients, cosineBase,
          sineBase, trial, residual, cosineTerm, sineTerm,
          cosineResidual, sineResidual, equations, variables, assignments,
          particular);
    parts := OdeExtTrigonometricPolynomialParts(forcing);
    if (Length(parts) != 3) [
        {};
    ] else [
        cosinePolynomial := parts[1];
        sinePolynomial := parts[2];
        frequency := parts[3];
        degree := Max(Degree(cosinePolynomial, x), Degree(sinePolynomial, x));
        resonance := If(Simplify(c - a*frequency^2) = 0 And
                        Simplify(b*frequency) = 0, 1, 0);
        cosineCoefficients := OdeExtConstantList(degree + 1);
        sineCoefficients := OdeExtConstantList(degree + 1);
        cosineBase := Add(cosineCoefficients * (x^(0 .. degree)));
        sineBase := Add(sineCoefficients * (x^(0 .. degree)));
        cosineTerm := Cos(frequency*x);
        sineTerm := Sin(frequency*x);
        trial := x^resonance *
                 (cosineBase*cosineTerm + sineBase*sineTerm);
        residual := Expand(a*OdeExtD2(trial) + b*OdeExtD1(trial) +
                           c*trial - forcing);
        cosineResidual := Simplify(Coef(residual, cosineTerm, 1));
        sineResidual := Simplify(Coef(residual, sineTerm, 1));
        /* Put sine equations first to align the leading equation with the
           cosine unknowns.  The inherited linear system solver has no row
           pivoting for a zero first diagonal entry. */
        equations := Concat(Coef(sineResidual, x, 0 .. degree + resonance),
                            Coef(cosineResidual, x, 0 .. degree + resonance));
        equations := Select({{coefficient}, coefficient != 0}, equations);
        variables := Concat(cosineCoefficients, sineCoefficients);
        if (Length(equations) > 0 And Length(variables) > 0 And
            IsFreeOf(variables[1], equations[1])) [
            variables := Reverse(variables);
        ];
        assignments := Solve(equations, variables);
        if (Length(assignments) != 1) [
            {};
        ] else [
            particular := OdeExtApplyAssignments(trial, assignments[1]);
            If(IsFreeOf(Undefined, particular) And
               Simplify(a*OdeExtD2(particular) +
                        b*OdeExtD1(particular) + c*particular - forcing) = 0,
               {particular, trial, equations,
                a*r^2 + b*r + c == 0},
               {});
        ];
    ];
];

RuleBase("OdeExtUndeterminedParticular", {a, b, c, forcing});
10 # OdeExtUndeterminedParticular(_a, _b, _c, _left + _right) <--
[
    Local(leftData, rightData);
    leftData := OdeExtUndeterminedParticular(a, b, c, left);
    rightData := OdeExtUndeterminedParticular(a, b, c, right);
    If(Length(leftData) = 4 And Length(rightData) = 4,
       {Simplify(leftData[1] + rightData[1]),
        leftData[2] + rightData[2],
        Concat(leftData[3], rightData[3]), leftData[4]},
       {});
];
11 # OdeExtUndeterminedParticular(_a, _b, _c, _left - _right) <--
[
    Local(leftData, rightData);
    leftData := OdeExtUndeterminedParticular(a, b, c, left);
    rightData := OdeExtUndeterminedParticular(a, b, c, right);
    If(Length(leftData) = 4 And Length(rightData) = 4,
       {Simplify(leftData[1] - rightData[1]),
        leftData[2] - rightData[2],
        Concat(leftData[3], rightData[3]), leftData[4]},
       {});
];
20 # OdeExtUndeterminedParticular(_a, _b, _c, _forcing) <--
[
    Local(result);
    result := OdeExtUndeterminedExponential(a, b, c, forcing);
    if (Length(result) != 4) [
        result := OdeExtUndeterminedTrigonometric(a, b, c, forcing);
    ];
    result;
];

RuleBase("OdeExtSolveUndeterminedCoefficients", {equation});
10 # OdeExtSolveUndeterminedCoefficients(_left == _right) <--
     OdeExtLegacy(OdeExtSolveUndeterminedCoefficientsPartsData(left == right, False));
100 # OdeExtSolveUndeterminedCoefficients(_equation) <-- {};

RuleBase("OdeExtSolveUndeterminedCoefficientsData", {equation});
10 # OdeExtSolveUndeterminedCoefficientsData(_left == _right) <--
     OdeExtSolveUndeterminedCoefficientsPartsData(left == right, True);
100 # OdeExtSolveUndeterminedCoefficientsData(_equation) <-- {};

RuleBase("OdeExtSolveUndeterminedCoefficientsPartsData", {equation, collect});
10 # OdeExtSolveUndeterminedCoefficientsPartsData(_left == _right, _collect) <--
[
    Local(normal, a, b, c, forcing, remainder, particularData,
          homogeneous, candidate, eventData);
    normal := Expand(left - right);
    a := Simplify(Coef(normal, y'', 1));
    b := Simplify(Coef(normal, y', 1));
    c := Simplify(Coef(normal, y, 1));
    remainder := Simplify(normal - a*y'' - b*y' - c*y);
    forcing := Simplify(-remainder);
    if (a = 0 Or forcing = 0 Or
        Not(IsFreeOf({x, y, y', y''}, {a, b, c})) Or
        Not(IsFreeOf({y, y', y''}, forcing))) [
        {};
    ] else [
        particularData := OdeExtUndeterminedParticular(a, b, c, forcing);
        if (Length(particularData) != 4) [
            {};
        ] else [
            homogeneous := OdeSolve(a*y'' + b*y' + c*y == 0);
            candidate := Simplify(homogeneous + particularData[1]);
            eventData := If(collect,
              {{OdeLinearConstantForm, a*y'' + b*y' + c*y == forcing, 2},
               {OdeCharacteristicEquation, particularData[4], 2},
               {OdeComplementarySolution, homogeneous, 1},
               {OdeTrialParticular, particularData[2], 2},
               {OdeCoefficientSystem, particularData[3], 1},
               {OdeParticularSolution, particularData[1], 2}}, {});
            {{candidate}, UndeterminedCoefficients, eventData};
        ];
    ];
];

/* Homogeneous second-order Euler-Cauchy equations on x>0. */
RuleBase("OdeExtSolveEulerCauchy", {equation});
10 # OdeExtSolveEulerCauchy(_left == _right) <--
     OdeExtLegacy(OdeExtSolveEulerCauchyPartsData(left == right, False));
100 # OdeExtSolveEulerCauchy(_equation) <-- {};

RuleBase("OdeExtSolveEulerCauchyData", {equation});
10 # OdeExtSolveEulerCauchyData(_left == _right) <--
     OdeExtSolveEulerCauchyPartsData(left == right, True);
100 # OdeExtSolveEulerCauchyData(_equation) <-- {};

RuleBase("OdeExtSolveEulerCauchyPartsData", {equation, collect});
10 # OdeExtSolveEulerCauchyPartsData(_left == _right, _collect) <--
[
    Local(normal, secondCoefficient, firstCoefficient, c, a, b,
          remainder, discriminant, alpha, beta, root1, root2,
          constants, candidate, characteristic, roots, eventData);
    normal := Expand(left - right);
    secondCoefficient := Simplify(Coef(normal, y'', 1));
    firstCoefficient := Simplify(Coef(normal, y', 1));
    c := Simplify(Coef(normal, y, 1));
    a := Simplify(secondCoefficient/x^2);
    b := Simplify(firstCoefficient/x);
    remainder := Simplify(normal-secondCoefficient*y''-firstCoefficient*y'-c*y);
    if (a = 0 Or remainder != 0 Or
        Simplify(secondCoefficient-a*x^2) != 0 Or
        Simplify(firstCoefficient-b*x) != 0 Or
        Not(IsFreeOf({x, y, y', y''}, {a, b, c}))) [
        {};
    ] else [
        discriminant := Simplify((b-a)^2-4*a*c);
        alpha := Simplify((a-b)/(2*a));
        constants := OdeExtConstantList(2);
        characteristic := a*m*(m-1)+b*m+c == 0;
        if (discriminant > 0) [
            root1 := Simplify((a-b+Sqrt(discriminant))/(2*a));
            root2 := Simplify((a-b-Sqrt(discriminant))/(2*a));
            roots := {root1, root2};
            candidate := constants[1]*OdeExtEulerPower(root1)+
                         constants[2]*OdeExtEulerPower(root2);
        ] else if (discriminant = 0) [
            roots := {alpha, alpha};
            candidate := x^alpha*(constants[1]+constants[2]*Ln(x));
        ] else if (discriminant < 0) [
            beta := Simplify(Sqrt(-discriminant)/(2*a));
            roots := {alpha+I*beta, alpha-I*beta};
            candidate := x^alpha*(constants[1]*Cos(beta*Ln(x))+
                                   constants[2]*Sin(beta*Ln(x)));
        ] else [
            candidate := Undefined;
            roots := {};
        ];
        if (candidate = Undefined) [
            {};
        ] else [
            eventData := If(collect,
              {{OdeEulerCauchyForm, a*x^2*y''+b*x*y'+c*y == 0, 2},
               {OdeEulerPowerSubstitution, y == x^m, 2},
               {OdeEulerCharacteristicEquation, characteristic, 2},
               {OdeEulerCharacteristicRoots, roots, 1},
               {OdeEulerGeneralSolution, candidate, 2}}, {});
            {{candidate}, EulerCauchy, eventData};
        ];
    ];
];

/* Exact first-order equations M(x,y)+N(x,y)y'=0.  Keep the potential
   equation implicit: forcing Solve(...,y) here can discard branches. */
RuleBase("OdeExtSolveExact", {equation});

10 # OdeExtSolveExact(_left == _right) <-- OdeExtLegacy(OdeExtSolveExactExpressionData(left - right, False));
100 # OdeExtSolveExact(_equation) <-- {};
10 # OdeExtSolveExactData(_left == _right) <-- OdeExtSolveExactExpressionData(left - right, True);
100 # OdeExtSolveExactData(_equation) <-- {};

OdeExtSolveExactExpressionData(_expression, _collect) <--
[
    Local(normal, degree, m, n, mxIntegral, correction, correctionIntegral,
          potential, constant, my, nx);
    normal := Simplify(expression);
    degree := Degree(normal, y');
    if (degree != 1) [
        {};
    ] else [
        m := Simplify(Coef(normal, y', 0));
        n := Simplify(Coef(normal, y', 1));
        my := ApplyPure("D", {y, m});
        nx := ApplyPure("D", {x, n});
        if (Not(IsFreeOf(y', {m, n})) Or Simplify(my - nx) != 0) [
            {};
        ] else [
            mxIntegral := Integrate(x) m;
            correction := Simplify(n - ApplyPure("D", {y, mxIntegral}));
            correctionIntegral := Integrate(y) correction;
            if (Not(IsFreeOf(Integrate, {mxIntegral, correctionIntegral}))) [
                {};
            ] else [
                potential := Simplify(mxIntegral + correctionIntegral);
                /* The two checks are also the certificate consumed by the host. */
                if (Simplify(ApplyPure("D", {x, potential}) - m) != 0 Or
                    Simplify(ApplyPure("D", {y, potential}) - n) != 0) [
                    {};
                ] else [
                    constant := UniqueConstant();
                    {{potential == constant}, Exact,
                     If(collect,
                        {{OdeExactForm, m + n*y' == 0, 2},
                         {OdeExactTest, my == nx, 2},
                         {OdePotential, potential == constant, 2}},
                        {})};
                ];
            ];
        ];
    ];
];

RuleBase("OdeExtVerifyExact", {equation, solution});
10 # OdeExtVerifyExact(_left == _right, _potential == _constant) _
     (IsFreeOf({x, y}, constant)) <--
[
    Local(normal, m, n);
    normal := Simplify(left - right);
    if (Degree(normal, y') != 1) [
        False;
    ] else [
        m := Simplify(Coef(normal, y', 0));
        n := Simplify(Coef(normal, y', 1));
        Simplify(ApplyPure("D", {x, potential}) - m) = 0 And
            Simplify(ApplyPure("D", {y, potential}) - n) = 0;
    ];
];
100 # OdeExtVerifyExact(_equation, _solution) <-- False;

/* Homogeneous first-order equations y'=F(y/x).  The v=y/x substitution
   gives x*v'=F(v)-v.  Equilibrium slopes remain separate line solutions. */
RuleBase("OdeExtSolveHomogeneous", {equation});
10 # OdeExtSolveHomogeneous(y' == _rhs) <-- OdeExtLegacy(OdeExtSolveHomogeneousRhsData(rhs, False));
100 # OdeExtSolveHomogeneous(_equation) <-- {};
10 # OdeExtSolveHomogeneousData(y' == _rhs) <-- OdeExtSolveHomogeneousRhsData(rhs, True);
100 # OdeExtSolveHomogeneousData(_equation) <-- {};

OdeExtSolveHomogeneousRhsData(_rhs, _collect) <--
[
    Local(transformed, denominator, integral, potential, constant,
          rootAssignments, solutions, root, line, eventData);
    transformed := Simplify(ApplyPure("Subst", {y/x, z, rhs}));
    if (Not(IsFreeOf({x, y}, transformed)) Or IsFreeOf(z, transformed)) [
        transformed := Simplify(ApplyPure("Subst", {y, z*x, rhs}));
    ];
    if (Not(IsFreeOf(x, transformed)) Or IsFreeOf(z, transformed)) [
        {};
    ] else [
        denominator := Simplify(transformed - z);
        if (denominator = 0) [
            {};
        ] else [
            solutions := {};
            eventData := If(collect,
              {{OdeRatioSubstitution, z == y/x, 2},
               {OdeHomogeneousReduced, x*z' == denominator, 2}}, {});
            integral := Integrate(z) (1 / denominator);
            if (IsFreeOf(Integrate, integral)) [
                potential := Simplify(
                    ApplyPure("Subst", {z, y/x, integral}) - Ln(x));
                constant := UniqueConstant();
                DestructiveAppend(solutions, potential == constant);
                if (collect) [
                    DestructiveAppend(eventData,
                                      {OdeIntegrateBoth, integral == Ln(x) + constant, 2});
                ];
            ];
            rootAssignments := Solve(denominator == 0, z);
            ForEach(root, rootAssignments) [
                if (Length(root) = 2) [
                    line := Simplify(x * root[2]);
                    DestructiveAppend(solutions, line);
                ];
            ];
            if (collect And Length(rootAssignments) > 0) [
                DestructiveAppend(eventData,
                                  {OdeEquilibriumBranches, rootAssignments, 1});
            ];
            If(Length(solutions) > 0,
               {solutions, Homogeneous,
                If(collect, eventData, {})},
               {});
        ];
    ];
];

RuleBase("OdeExtVerifyHomogeneous", {equation, solution});
10 # OdeExtVerifyHomogeneous(_left == _right, _potential == _constant) _
     (IsFreeOf({x, y}, constant)) <--
[
    Local(normal, m, n, fx, fy, derivedRhs);
    normal := Simplify(left - right);
    if (Degree(normal, y') != 1) [
        False;
    ] else [
        m := Simplify(Coef(normal, y', 0));
        n := Simplify(Coef(normal, y', 1));
        fx := ApplyPure("D", {x, potential});
        fy := ApplyPure("D", {y, potential});
        if (n = 0 Or fy = 0) [
            False;
        ] else [
            derivedRhs := Simplify(-fx / fy);
            Simplify(derivedRhs + m / n) = 0;
        ];
    ];
];
100 # OdeExtVerifyHomogeneous(_equation, _solution) <-- False;

5 # ExtendedOdeSolve(y' == _rhs) _
    (IsFreeOf(y, rhs)) <-- {{OdeSolve(y' == rhs)}, Upstream};

10 # ExtendedOdeSolve(y' == _rhs) <--
[
    Local(result);
    result := OdeExtSolveSeparable(y' == rhs);
    if (Length(result) != 2) [
        result := OdeExtSolveLinearFirstOrder(y' == rhs);
    ];
    if (Length(result) != 2) [
        result := OdeExtSolveHomogeneous(y' == rhs);
    ];
    If(Length(result) = 2, result, {{OdeSolve(y' == rhs)}, Upstream});
];

20 # ExtendedOdeSolve(y' + _dependentTerm == _rhs) <--
[
    Local(result);
    result := OdeExtSolveLinearFirstOrder(y' + dependentTerm == rhs);
    if (Length(result) != 2) [
        result := OdeExtSolveBernoulli(y' + dependentTerm == rhs);
    ];
    if (Length(result) != 2) [
        result := OdeExtSolveExact(y' + dependentTerm == rhs);
    ];
    If(Length(result) = 2,
       result,
       {{OdeSolve(y' + dependentTerm == rhs)}, Upstream});
];
21 # ExtendedOdeSolve(y' - _dependentTerm == _rhs) <--
[
    Local(result);
    result := OdeExtSolveLinearFirstOrder(y' - dependentTerm == rhs);
    if (Length(result) != 2) [
        result := OdeExtSolveExact(y' - dependentTerm == rhs);
    ];
    If(Length(result) = 2,
       result,
       {{OdeSolve(y' - dependentTerm == rhs)}, Upstream});
];
22 # ExtendedOdeSolve(_dependentTerm + y' == _rhs) <--
[
    Local(result);
    result := OdeExtSolveLinearFirstOrder(dependentTerm + y' == rhs);
    if (Length(result) != 2) [
        result := OdeExtSolveExact(dependentTerm + y' == rhs);
    ];
    If(Length(result) = 2,
       result,
       {{OdeSolve(dependentTerm + y' == rhs)}, Upstream});
];

100 # ExtendedOdeSolve(_equation) <--
[
    Local(result);
    result := OdeExtSolveUndeterminedCoefficients(equation);
    if (Length(result) != 2) [
        result := OdeExtSolveEulerCauchy(equation);
    ];
    if (Length(result) != 2) [
        result := OdeExtSolveExact(equation);
    ];
    if (Length(result) != 2) [
        result := OdeExtSolveHomogeneous(equation);
    ];
    If(Length(result) = 2, result, {{OdeSolve(equation)}, Upstream});
];
