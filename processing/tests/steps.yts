/* steps.yts -- StepsD step generator tests.
   Structure: each step = {rule-name, expression}.
   All final results are checked against the engine's own D(). */

/* LastStepExpr(s): expression of the final step (1.9.2 has no Last). */
LastStepExpr(s) :=
[
  Local(last);
  last := s[Length(s)];
  last[2];
];

/* FirstRule(s): rule name of the first step. */
FirstRule(s) :=
[
  Local(first);
  first := s[1];
  first[1];
];

/* Basic rules */
TestYacas(LastStepExpr(StepsD(x, x)), 1);
TestYacas(LastStepExpr(StepsD(5, x)), 0);
TestYacas(LastStepExpr(StepsD(x + 1, x)), 1);
TestYacas(LastStepExpr(StepsD(2 * x, x)), 2);
TestYacas(LastStepExpr(StepsD(-x, x)), -1);

/* Power rule */
TestYacas(LastStepExpr(StepsD(x ^ 2, x)), 2 * x);
TestYacas(LastStepExpr(StepsD(x ^ 5, x)), 5 * x ^ 4);

/* Sum + power */
TestYacas(LastStepExpr(StepsD(x ^ 3 + 2 * x, x)), 3 * x ^ 2 + 2);

/* Product / constant multiple */
TestYacas(LastStepExpr(StepsD(x * Sin(x), x)), D(x) x * Sin(x));
TestYacas(LastStepExpr(StepsD(3 * x ^ 2, x)), 6 * x);

/* Quotient */
TestYacas(LastStepExpr(StepsD(Sin(x) / x, x)), D(x)(Sin(x) / x));

/* Chain rule */
TestYacas(LastStepExpr(StepsD(Sin(x) ^ 2, x)), D(x) Sin(x) ^ 2);
TestYacas(LastStepExpr(StepsD(Sin(x ^ 2), x)), D(x) Sin(x ^ 2));
TestYacas(LastStepExpr(StepsD(Exp(x ^ 2), x)), D(x) Exp(x ^ 2));
TestYacas(LastStepExpr(StepsD(Ln(x ^ 2 + 1), x)), D(x) Ln(x ^ 2 + 1));
TestYacas(LastStepExpr(StepsD(Sqrt(x ^ 2 + 1), x)), D(x) Sqrt(x ^ 2 + 1));

/* Exponential rule */
TestYacas(LastStepExpr(StepsD(2 ^ x, x)), D(x) 2 ^ x);

/* Composite */
TestYacas(LastStepExpr(StepsD((x ^ 2 + 1) * Exp(x), x)), D(x)((x ^ 2 + 1) * Exp(x)));

/* M1: 三角/反三角/双曲(与引擎 D 对照)。注意 Cot/Sec/Csc 在求值时已被
   引擎规范化为 1/Tan、1/Cos、1/Sin —— 这三条断言钉住的是规范化行为:
   步骤经商法则展开,最终形态与引擎直接求值一致(代数恒等于 -Csc^2 等)。 */
TestYacas(LastStepExpr(StepsD(Tan(x), x)), D(x) Tan(x));
TestYacas(LastStepExpr(StepsD(Cot(x), x)), D(x) Cot(x));
TestYacas(LastStepExpr(StepsD(Sec(x), x)), D(x) Sec(x));
TestYacas(LastStepExpr(StepsD(Csc(x), x)), D(x) Csc(x));
TestYacas(LastStepExpr(StepsD(ArcSin(x), x)), D(x) ArcSin(x));
TestYacas(LastStepExpr(StepsD(ArcCos(x), x)), D(x) ArcCos(x));
TestYacas(LastStepExpr(StepsD(ArcTan(x), x)), D(x) ArcTan(x));
TestYacas(LastStepExpr(StepsD(Sinh(x), x)), D(x) Sinh(x));
TestYacas(LastStepExpr(StepsD(Cosh(x), x)), D(x) Cosh(x));
TestYacas(LastStepExpr(StepsD(Tanh(x), x)), D(x) Tanh(x));

/* M1: 链式法则显式入册(复合参数登记 "<name>-chain-rule" 键) */
Verify(FirstRule(StepsD(Tan(x ^ 2), x)), "tan-chain-rule");
Verify(FirstRule(StepsD(ArcTan(x ^ 2), x)), "arctan-chain-rule");
Verify(FirstRule(StepsD(Sinh(x ^ 2), x)), "sinh-chain-rule");
Verify(FirstRule(StepsD(2 ^ (x ^ 2), x)), "exponential-chain-rule");
Verify(FirstRule(StepsD(Ln(Sin(x)), x)), "ln-chain-rule");
Verify(FirstRule(StepsD(Sin(x), x)), "sin-rule");  /* 参数恰为自变量,普通键 */

/* M1: 高阶导数(逐轮拼接,与引擎 D(x,2) 对照) */
TestYacas(LastStepExpr(StepsD'Full(x ^ 4, x, 2)), D(x,2) x ^ 4);
TestYacas(LastStepExpr(StepsD'Full(Sin(x), x, 2)), D(x,2) Sin(x));

/* Structural properties: at least 2 steps; no DPrime in the final step */
Verify(Length(StepsD(x * Sin(x), x)) >= 2, True);
Verify(IsFreeOf(DPrime, LastStepExpr(StepsD(x * Sin(x), x))), True);
Verify(IsFreeOf(DPrime, LastStepExpr(StepsD(Sin(x ^ 2), x))), True);
Verify(FirstRule(StepsD(x * Sin(x), x)), "product-rule");
Verify(FirstRule(StepsD(Sin(x) / x, x)), "quotient-rule");

/* ---------- StepsI 不定积分 ---------- */

/* 基本情形(与引擎 Integrate 对照) */
TestYacas(LastStepExpr(StepsI(x^2, x)), Integrate(x) x^2);
TestYacas(LastStepExpr(StepsI(Sin(x), x)), Integrate(x) Sin(x));
TestYacas(LastStepExpr(StepsI(Cos(x), x)), Integrate(x) Cos(x));
TestYacas(LastStepExpr(StepsI(Exp(x), x)), Integrate(x) Exp(x));
TestYacas(LastStepExpr(StepsI(1/x, x)), Integrate(x) 1/x);
TestYacas(LastStepExpr(StepsI(5, x)), Integrate(x) 5);
TestYacas(LastStepExpr(StepsI(x*Sin(x), x)), Integrate(x) x*Sin(x));
TestYacas(LastStepExpr(StepsI(Cos(x)+x^3, x)), Integrate(x)(Cos(x)+x^3));

/* u-substitution(硬编码预期,引擎对部分用例无法直接积分) */
TestYacas(LastStepExpr(StepsI(Sin(x^2)*2*x, x)), -Cos(x^2));
TestYacas(LastStepExpr(StepsI(Cos(2*x), x)), Sin(2*x)/2);
TestYacas(LastStepExpr(StepsI(Exp(3*x), x)), Exp(3*x)/3);
TestYacas(LastStepExpr(StepsI(2*x/(x^2+1), x)), Ln(x^2+1));
TestYacas(LastStepExpr(StepsI((2*x+1)^5, x)), (2*x+1)^6/12);

/* 结构性质:u-sub 用例含回代步;最终步不再有 Int 标记 */
Verify(FirstRule(StepsI(Sin(x^2)*2*x, x)), "constant-multiple-rule");
Verify(Length(StepsI(Cos(2*x), x)) >= 3, True);
Verify(IsFreeOf(Int, LastStepExpr(StepsI(Sin(x^2)*2*x, x))), True);
Verify(IsFreeOf(Int, LastStepExpr(StepsI(2*x/(x^2+1), x))), True);

/* arctan 族(算法书 IntPureSquare 的教学化拆分) */
TestYacas(LastStepExpr(StepsI(1/(1+x^2), x)), ArcTan(x));
TestYacas(LastStepExpr(StepsI(3/(1+x^2), x)), 3*ArcTan(x));
TestYacas(LastStepExpr(StepsI(Cos(x)/(1+Sin(x)^2), x)), ArcTan(Sin(x)));
Verify(FirstRule(StepsI(1/(1+x^2), x)), "arctan-rule");

/* M1: 三角/双曲基本表(与引擎 Integrate 对照)+ 反正弦形(硬编码预期) */
TestYacas(LastStepExpr(StepsI(Tan(x), x)), Integrate(x) Tan(x));
TestYacas(LastStepExpr(StepsI(Cot(x), x)), Integrate(x) Cot(x));
TestYacas(LastStepExpr(StepsI(Sinh(x), x)), Integrate(x) Sinh(x));
TestYacas(LastStepExpr(StepsI(Cosh(x), x)), Integrate(x) Cosh(x));
TestYacas(LastStepExpr(StepsI(Tanh(x), x)), Integrate(x) Tanh(x));
TestYacas(LastStepExpr(StepsI(2/Sqrt(1 - x^2), x)), 2*ArcSin(x));

/* 分部积分(LIATE) */
TestYacas(LastStepExpr(StepsI(x*Sin(x), x)), Integrate(x) x*Sin(x));
TestYacas(LastStepExpr(StepsI(x*Cos(x), x)), Integrate(x) x*Cos(x));
TestYacas(LastStepExpr(StepsI(x*Exp(x), x)), Integrate(x) x*Exp(x));
TestYacas(LastStepExpr(StepsI(x^2*Sin(x), x)), 2*(x*Sin(x)+Cos(x))-x^2*Cos(x));  /* 引擎答案有误(见 RESEARCH §8.5),用硬编码预期 */
TestYacas(LastStepExpr(StepsI(Ln(x), x)), Integrate(x) Ln(x));
TestYacas(LastStepExpr(StepsI(Ln(x)*x, x)), Integrate(x) Ln(x)*x);
Verify(FirstRule(StepsI(x*Sin(x), x)), "parts-rule");

/* 反向因子 u-substitution(代数在前、复合函数在后) */
TestYacas(LastStepExpr(StepsI(x*Sin(x^2), x)), (-Cos(x^2))/2);
TestYacas(LastStepExpr(StepsI(x^2*Cos(x^3), x)), Sin(x^3)/3);
TestYacas(LastStepExpr(StepsI(2*x*Exp(x^2), x)), Exp(x^2));

/* 引擎 Integrate 修复验证(§8.5:常数 exy 退化情形) */
TestYacas(Integrate(x) x^2*Sin(x), 2*(x*Sin(x)+Cos(x))-x^2*Cos(x));
TestYacas(Integrate(x) 2*x*Cos(x), 2*(x*Sin(x)+Cos(x)));

/* 解释文案(声明式):查询命中/侧感知/兜底/Full 三元组 */
FirstWhy(s) :=
[
  Local(first);
  first := s[1];
  first[3];
];
TestYacas(Steps'Explain("power-rule"), "幂法则: (u^n)' = n*u^(n-1)*u'");
TestYacas(Steps'Explain("sum-rule"), "和法则: (f + g)' = f' + g'");
TestYacas(Steps'Explain("arctan-rule"), "反正切法则: (ArcTan(u))' = u'/(1 + u^2)");
TestYacas(Steps'ExplainFor("arctan-rule", "i"), "反正切积分: ∫1/(1 + x^2) dx = ArcTan(x)");
TestYacas(Steps'ExplainFor("tan-rule", "i"), "正切积分: ∫Tan(x) dx = -Ln(Cos(x))");
TestYacas(FirstWhy(StepsD'Full(Tan(x ^ 2), x)), "链式法则: (Tan(u))' = u'/Cos(u)^2");
/* 侧感知:积分侧覆盖,求导侧回退通用键 */
TestYacas(Steps'ExplainFor("power-rule", "d"), Steps'Explain("power-rule"));
TestYacas(Steps'ExplainFor("power-rule", "i"), "幂法则: ∫x^n dx = x^(n+1)/(n + 1) (n ≠ -1)");
TestYacas(Steps'ExplainFor("direct", "d"), "直接求导");
TestYacas(Steps'ExplainFor("direct", "i"), "直接积分");
TestYacas(Steps'Explain("no-such-rule"), "");
TestYacas(Steps'ExplainFor("no-such-rule", "i"), "");
TestYacas(Length(StepsD'Full(x^2, x)), Length(StepsD(x^2, x)));
TestYacas(FirstWhy(StepsD'Full(x, x)), Steps'Explain("identity-rule"));
TestYacas(FirstWhy(StepsI'Full(x*Sin(x), x)), Steps'Explain("parts-rule"));
