/* 积分规范:基本表(与引擎 Integrate 对照)/ arctan 族 / M1 三角双曲表。 */

/* 基本情形(与引擎 Integrate 对照) */
TestYacas(LastStepExpr(StepsI(x^2, x)), Integrate(x) x^2);
TestYacas(LastStepExpr(StepsI(Sin(x), x)), Integrate(x) Sin(x));
TestYacas(LastStepExpr(StepsI(Cos(x), x)), Integrate(x) Cos(x));
TestYacas(LastStepExpr(StepsI(Exp(x), x)), Integrate(x) Exp(x));
TestYacas(LastStepExpr(StepsI(1/x, x)), Integrate(x) 1/x);
TestYacas(LastStepExpr(StepsI(5, x)), Integrate(x) 5);
TestYacas(LastStepExpr(StepsI(x*Sin(x), x)), Integrate(x) x*Sin(x));
TestYacas(LastStepExpr(StepsI(Cos(x)+x^3, x)), Integrate(x)(Cos(x)+x^3));

/* arctan 族(算法书 IntPureSquare 的教学化拆分) */
TestYacas(LastStepExpr(StepsI(1/(1+x^2), x)), ArcTan(x));
TestYacas(LastStepExpr(StepsI(3/(1+x^2), x)), 3*ArcTan(x));
TestYacas(LastStepExpr(StepsI(Cos(x)/(1+Sin(x)^2), x)), ArcTan(Sin(x)));
Verify(FirstRule(StepsI(1/(1+x^2), x)), "arctan-rule");

/* M1: 三角/双曲基本表(与引擎 Integrate 对照)+ 反正弦形(硬编码预期) */
TestYacas(LastStepExpr(StepsI(Tan(x), x)), Integrate(x) Tan(x));
TestYacas(LastStepExpr(StepsI(Cot(x), x)), Integrate(x) Cot(x));
TestYacas(LastStepExpr(StepsI(Sinh(x), x)), Integrate(x) Sinh(x));
TestYacas(LastStepExpr(StepsI(Cosh(x), x)), Integrate(x) Cosh(x));
TestYacas(LastStepExpr(StepsI(Tanh(x), x)), Integrate(x) Tanh(x));
TestYacas(LastStepExpr(StepsI(2/Sqrt(1 - x^2), x)), 2*ArcSin(x));

/* M2c: 三角/双曲形式表(一般正常数 a)。前两条与引擎 Integrate 对照;
   引擎对 Sqrt(x^2 ± a^2) 无解析路径,后两条用硬编码预期(求导可自验) */
TestYacas(LastStepExpr(StepsI(1/(x^2 + 4), x)), Integrate(x) 1/(x^2 + 4));
TestYacas(LastStepExpr(StepsI(1/Sqrt(4 - x^2), x)), Integrate(x) 1/Sqrt(4 - x^2));
TestYacas(LastStepExpr(StepsI(x/Sqrt(x^2 + 4), x)), Sqrt(x^2 + 4));
TestYacas(LastStepExpr(StepsI(1/Sqrt(x^2 + 4), x)), Ln(x + Sqrt(x^2 + 4)));
TestYacas(LastStepExpr(StepsI(3/Sqrt(x^2 - 4), x)), 3*Ln(x + Sqrt(x^2 - 4)));
Verify(FirstRule(StepsI(1/(x^2 + 4), x)), "arctan-rule");

/* 幂约简递推(Sin^n/Cos^n,n 整数 >= 2):每步显式,终式教科书形 */
TestYacas(LastStepExpr(StepsI(Sin(x)^2, x)), (x/2) - (Sin(x)*Cos(x))/2);
TestYacas(LastStepExpr(StepsI(Cos(x)^3, x)), ((Cos(x)^2*Sin(x)) + (2*Sin(x)))/3);
Verify(FirstRule(StepsI(Sin(x)^4, x)), "power-reduction-rule");

/* Tan/Sec 幂递推。Sec 在引擎中规范化为 1/Cos。除钉住教材形结果外，
   用求导恒等独立验证递推终式，不依赖上游积分器是否支持该高次表项。 */
TestYacas(LastStepExpr(StepsI(Tan(x)^2, x)), Tan(x) - x);
TestYacas(LastStepExpr(StepsI(Tan(x)^3, x)), Tan(x)^2/2 + Ln(Cos(x)));
TestYacas(LastStepExpr(StepsI(Sec(x)^3, x)), Tan(x)/(2*Cos(x)) + Ln(1/Cos(x) + Tan(x))/2);
Verify(FirstRule(StepsI(Tan(x)^4, x)), "tan-power-reduction-rule");
Verify(FirstRule(StepsI(Sec(x)^4, x)), "sec-power-reduction-rule");
TestYacas(LastStepExpr(StepsI(Tan(x)^5, x)), Tan(x)^4/4 - Tan(x)^2/2 - Ln(Cos(x)));
TestYacas(LastStepExpr(StepsI(Sec(x)^5, x)), Tan(x)/(4*Cos(x)^3) + 3*Tan(x)/(8*Cos(x)) + 3*Ln(1/Cos(x) + Tan(x))/8);
TestYacas(RoundTo(N(Eval(ApplyPure("Subst", {x,1/4,Deriv(x) LastStepExpr(StepsI(Tan(x)^5, x))}))), 8), RoundTo(N(Tan(1/4)^5), 8));
TestYacas(RoundTo(N(Eval(ApplyPure("Subst", {x,1/4,Deriv(x) LastStepExpr(StepsI(Sec(x)^5, x))}))), 8), RoundTo(N(Sec(1/4)^5), 8));
