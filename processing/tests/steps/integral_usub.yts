/* 积分规范:换元(硬编码预期,引擎对部分用例无法直接积分;
   正向与反向因子两序)+ 结构性质(回代步、最终步无 Int 标记)。 */

/* u-substitution(硬编码预期,引擎对部分用例无法直接积分) */
TestYacas(LastStepExpr(StepsI(Sin(x^2)*2*x, x)), -Cos(x^2));
TestYacas(LastStepExpr(StepsI(Cos(2*x), x)), Sin(2*x)/2);
TestYacas(LastStepExpr(StepsI(Exp(3*x), x)), Exp(3*x)/3);
TestYacas(LastStepExpr(StepsI(2*x/(x^2+1), x)), Ln(x^2+1));
TestYacas(LastStepExpr(StepsI((2*x+1)^5, x)), (2*x+1)^6/12);

/* 结构性质:u-sub 用例含回代步;最终步不再有 Int 标记 */
Verify(FirstRule(StepsI(Sin(x^2)*2*x, x)), "constant-multiple-rule");
Verify(Length(StepsI(Cos(2*x), x)) >= 3, True);
Verify(IsFreeOf(Int, LastStepExpr(StepsI(Sin(x^2)*2*x, x))), True);
Verify(IsFreeOf(Int, LastStepExpr(StepsI(2*x/(x^2+1), x))), True);

/* 反向因子 u-substitution(代数在前、复合函数在后) */
TestYacas(LastStepExpr(StepsI(x*Sin(x^2), x)), (-Cos(x^2))/2);
TestYacas(LastStepExpr(StepsI(x^2*Cos(x^3), x)), Sin(x^3)/3);
TestYacas(LastStepExpr(StepsI(2*x*Exp(x^2), x)), Exp(x^2));
