/* 求导规范:基础法则 / M1 函数覆盖 / 链式键 / 高阶导数 / 结构性质。 */

/* Basic rules */
TestYacas(LastStepExpr(StepsD(x, x)), 1);
TestYacas(LastStepExpr(StepsD(5, x)), 0);
TestYacas(LastStepExpr(StepsD(x + 1, x)), 1);
TestYacas(LastStepExpr(StepsD(2 * x, x)), 2);
TestYacas(LastStepExpr(StepsD(-x, x)), -1);

/* Power rule */
TestYacas(LastStepExpr(StepsD(x ^ 2, x)), 2 * x);
TestYacas(LastStepExpr(StepsD(x ^ 5, x)), 5 * x ^ 4);

/* Sum + power */
TestYacas(LastStepExpr(StepsD(x ^ 3 + 2 * x, x)), 3 * x ^ 2 + 2);

/* Product / constant multiple */
TestYacas(LastStepExpr(StepsD(x * Sin(x), x)), D(x) x * Sin(x));
TestYacas(LastStepExpr(StepsD(3 * x ^ 2, x)), 6 * x);

/* Quotient */
TestYacas(LastStepExpr(StepsD(Sin(x) / x, x)), D(x)(Sin(x) / x));

/* Chain rule */
TestYacas(LastStepExpr(StepsD(Sin(x) ^ 2, x)), D(x) Sin(x) ^ 2);
TestYacas(LastStepExpr(StepsD(Sin(x ^ 2), x)), D(x) Sin(x ^ 2));
TestYacas(LastStepExpr(StepsD(Exp(x ^ 2), x)), D(x) Exp(x ^ 2));
TestYacas(LastStepExpr(StepsD(Ln(x ^ 2 + 1), x)), D(x) Ln(x ^ 2 + 1));
TestYacas(LastStepExpr(StepsD(Sqrt(x ^ 2 + 1), x)), D(x) Sqrt(x ^ 2 + 1));

/* Exponential rule */
TestYacas(LastStepExpr(StepsD(2 ^ x, x)), D(x) 2 ^ x);

/* Composite */
TestYacas(LastStepExpr(StepsD((x ^ 2 + 1) * Exp(x), x)), D(x)((x ^ 2 + 1) * Exp(x)));

/* M1: 三角/反三角/双曲(与引擎 D 对照)。注意 Cot/Sec/Csc 在求值时已被
   引擎规范化为 1/Tan、1/Cos、1/Sin —— 这三条断言钉住的是规范化行为:
   步骤经商法则展开,最终形态与引擎直接求值一致(代数恒等于 -Csc^2 等)。 */
TestYacas(LastStepExpr(StepsD(Tan(x), x)), D(x) Tan(x));
TestYacas(LastStepExpr(StepsD(Cot(x), x)), D(x) Cot(x));
TestYacas(LastStepExpr(StepsD(Sec(x), x)), D(x) Sec(x));
TestYacas(LastStepExpr(StepsD(Csc(x), x)), D(x) Csc(x));
TestYacas(LastStepExpr(StepsD(ArcSin(x), x)), D(x) ArcSin(x));
TestYacas(LastStepExpr(StepsD(ArcCos(x), x)), D(x) ArcCos(x));
TestYacas(LastStepExpr(StepsD(ArcTan(x), x)), D(x) ArcTan(x));
TestYacas(LastStepExpr(StepsD(Sinh(x), x)), D(x) Sinh(x));
TestYacas(LastStepExpr(StepsD(Cosh(x), x)), D(x) Cosh(x));
TestYacas(LastStepExpr(StepsD(Tanh(x), x)), D(x) Tanh(x));

/* M1: 链式法则显式入册(复合参数登记 "<name>-chain-rule" 键) */
Verify(FirstRule(StepsD(Tan(x ^ 2), x)), "tan-chain-rule");
Verify(FirstRule(StepsD(ArcTan(x ^ 2), x)), "arctan-chain-rule");
Verify(FirstRule(StepsD(Sinh(x ^ 2), x)), "sinh-chain-rule");
Verify(FirstRule(StepsD(2 ^ (x ^ 2), x)), "exponential-chain-rule");
Verify(FirstRule(StepsD(Ln(Sin(x)), x)), "ln-chain-rule");
Verify(FirstRule(StepsD(Sin(x), x)), "sin-rule");  /* 参数恰为自变量,普通键 */

/* M1: 高阶导数(逐轮拼接,与引擎 D(x,2) 对照) */
TestYacas(LastStepExpr(StepsD'Full(x ^ 4, x, 2)), D(x,2) x ^ 4);
TestYacas(LastStepExpr(StepsD'Full(Sin(x), x, 2)), D(x,2) Sin(x));

/* Structural properties: at least 2 steps; no DPrime in the final step */
Verify(Length(StepsD(x * Sin(x), x)) >= 2, True);
Verify(IsFreeOf(DPrime, LastStepExpr(StepsD(x * Sin(x), x))), True);
Verify(IsFreeOf(DPrime, LastStepExpr(StepsD(Sin(x ^ 2), x))), True);
Verify(FirstRule(StepsD(x * Sin(x), x)), "product-rule");
Verify(FirstRule(StepsD(Sin(x) / x, x)), "quotient-rule");
