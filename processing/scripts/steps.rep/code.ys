/* steps.rep/code.ys
   Step generators: differentiation (StepsD) and integration (StepsI), pedagogical.

   Design:
   - Raw steps are {rule, kind, target, after}:
     - kind "p" (pending): replace Pending(target) by after, where Pending is
       DPrime (StepsD) or Int (StepsI);
     - kind "s" (symbol): replace the symbol target by after (u-substitution
       back-substitution);
     - kind "m" (method): strategy banner, no substitution (the method
       declaration heads a multi-step technique: u-sub / parts / partial
       fractions).
   - SD'Merge(cur, sub, pending) applies raw steps to a running expression and
     returns visible steps {rule, expression} plus the final expression.
   - Rule ordering: the generic fallback rule must be defined FIRST (later
     rules win in 1.9.2).

   NOTES (all verified empirically against 1.9.2, see ../RESEARCH.md §7):
   - pattern rules (10 #) must NOT be wrapped in LocalSymbols blocks;
   - pattern variable names must avoid "expr"/"var";
   - Subst is a bodied operator in 1.9.2, call via ApplyPure("Subst", ...);
   - IsFreeOf(var, expr): variable FIRST, expression SECOND;
   - D/Integrate/Deriv are bodied operators: D(var)expr, Integrate(var)expr.
   - Tests: tests/steps/*.yts(runner: tests/steps_yts.rs).
*/

RuleBase("StepsD", {expr, var});
RuleBase("SD'Diff", {f, v});
RuleBase("StepsI", {expr, var});
RuleBase("SI'Diff", {f, v});

/* ---------- 通用:把原始步骤应用到运行中表达式 ---------- */

SD'Merge(cur, sub, pending) :=
[
  Local(steps, i, s, rule, kind, t, after);
  steps := {};
  For (i := 1, i <= Length(sub[1]), i++)
  [
    s := sub[1];
    s := s[i];
    rule := s[1];
    kind := s[2];
    t := s[3];
    after := s[4];
    If (kind = "m",
      cur := cur,
      If (kind = "s",
        cur := ApplyPure("Subst", {t, after, cur}),
        cur := ApplyPure("Subst", {Apply(pending, {t}), after, cur})));
    steps := Append(steps, {rule, cur});
  ];
  {steps, cur};
];

/* ---------- 轻量化简 Tidy:仅采纳"局部清理"式的化简 ---------- */

RuleBase("Tidy", {expr});

/* 仅当 Simplify 的结果是原表达式的子表达式时采纳(用 Subst 探测):
   展开/合并公分母会重构结构(不再是子表达式),天然被拒,保留原形式。 */
Tidy(expr) :=
[
  Local(s, probe);
  s := Simplify(expr);
  probe := ApplyPure("Subst", {s, Tidy'Marker, expr});
  If (probe = expr, expr, s);
];

/* ============================================================
   求导步骤 StepsD
   ============================================================ */

StepsD(expr, var) :=
[
  Local(p, steps, tidied);
  p := SD'Merge(DPrime(expr), SD'Diff(expr, var), "DPrime");
  tidied := Tidy(p[2]);
  If (tidied = p[2],
    steps := p[1],
    steps := Append(p[1], {"simplify", tidied}));
  steps;
];

/* 兜底(最先定义):常数 / 自变量 / 未知结构 */
10 # SD'Diff(_f, _v) <--
  If (IsNumber(f) Or IsFreeOf(v, f),
    {{{"const-rule", "p", f, 0}}, 0},
    If (f = v,
      {{{"identity-rule", "p", f, 1}}, 1},
      {{{"direct", "p", f, Deriv(v) f}}, Deriv(v) f}
    )
  );

/* 一元负号:按常数倍 -1 处理 */
10 # SD'Diff(-_f, _v) <--
[
  Local(steps, cur, sf);
  steps := {{"constant-multiple-rule", "p", -f, -DPrime(f)}};
  cur := -DPrime(f);
  sf := SD'Diff(f, v);
  cur := SD'Merge(cur, sf, "DPrime")[2];
  steps := Concat(steps, sf[1]);
  {steps, cur};
];

/* 和法则 */
10 # SD'Diff(_a + _b, _v) <--
[
  Local(steps, cur, p, sa, sb);
  steps := {{"sum-rule", "p", a + b, DPrime(a) + DPrime(b)}};
  cur := DPrime(a) + DPrime(b);
  sa := SD'Diff(a, v);
  cur := SD'Merge(cur, sa, "DPrime")[2];
  steps := Concat(steps, sa[1]);
  sb := SD'Diff(b, v);
  cur := SD'Merge(cur, sb, "DPrime")[2];
  steps := Concat(steps, sb[1]);
  {steps, cur};
];

/* 积法则 / 常数倍法则 */
10 # SD'Diff(_a * _b, _v) <--
[
  Local(steps, cur, p, sa, sb);
  If (IsFreeOf(v, a),
    [ /* 常数倍法则:c*f' */
      steps := {{"constant-multiple-rule", "p", a * b, a * DPrime(b)}};
      cur := a * DPrime(b);
      sb := SD'Diff(b, v);
      cur := SD'Merge(cur, sb, "DPrime")[2];
      steps := Concat(steps, sb[1]);
    ],
    [ /* 乘积法则:f'*g + f*g' */
      steps := {{"product-rule", "p", a * b, DPrime(a) * b + a * DPrime(b)}};
      cur := DPrime(a) * b + a * DPrime(b);
      sa := SD'Diff(a, v);
      cur := SD'Merge(cur, sa, "DPrime")[2];
      steps := Concat(steps, sa[1]);
      sb := SD'Diff(b, v);
      cur := SD'Merge(cur, sb, "DPrime")[2];
      steps := Concat(steps, sb[1]);
    ]);
  {steps, cur};
];

/* 商法则 */
10 # SD'Diff(_a / _b, _v) <--
[
  Local(steps, cur, p, sa, sb);
  steps := {{"quotient-rule", "p", a / b, (DPrime(a) * b - a * DPrime(b)) / b ^ 2}};
  cur := (DPrime(a) * b - a * DPrime(b)) / b ^ 2;
  sa := SD'Diff(a, v);
  cur := SD'Merge(cur, sa, "DPrime")[2];
  steps := Concat(steps, sa[1]);
  sb := SD'Diff(b, v);
  cur := SD'Merge(cur, sb, "DPrime")[2];
  steps := Concat(steps, sb[1]);
  {steps, cur};
];

/* 幂法则 / 指数法则 */
10 # SD'Diff(_a ^ _b, _v) <--
[
  Local(steps, cur, p, sa, sb);
  If (IsFreeOf(v, b),
    [ /* 幂法则(含链式):b*a^(b-1) * a' */
      steps := {{If (a = v, "power-rule", "power-chain-rule"), "p", a ^ b, b * a ^ (b - 1) * DPrime(a)}};
      cur := b * a ^ (b - 1) * DPrime(a);
      sa := SD'Diff(a, v);
      cur := SD'Merge(cur, sa, "DPrime")[2];
      steps := Concat(steps, sa[1]);
    ],
    If (IsFreeOf(v, a),
      [ /* 指数法则:a^b * Ln(a) * b' */
        steps := {{If (b = v, "exponential-rule", "exponential-chain-rule"), "p", a ^ b, a ^ b * Ln(a) * DPrime(b)}};
        cur := a ^ b * Ln(a) * DPrime(b);
        sb := SD'Diff(b, v);
        cur := SD'Merge(cur, sb, "DPrime")[2];
        steps := Concat(steps, sb[1]);
      ],
      [ /* 底和指数都依赖自变量:直接求导兜底 */
        steps := {{"direct", "p", a ^ b, Deriv(v)(a ^ b)}};
        cur := Deriv(v)(a ^ b);
      ]));
  {steps, cur};
];

/* 基本函数(链式) */
/* 函数规则通用驱动:对 f(u) 施加外层导数公式 after(含 DPrime(u) 待定内层导数),
   然后递归展开内层 u。u = v(参数恰为自变量)登记 "<name>-rule" 键,
   复合时登记 "<name>-chain-rule" 键 —— 链式法则显式入册。
   各外层导数公式与 deriv.rep 的规范形一致,Tidy/Simplify 可直接衔接。 */
SD'FuncDiff(name, f, after, u, v) :=
[
  Local(steps, cur, su);
  steps := {{If (u = v, ConcatStrings(name, "-rule"), ConcatStrings(name, "-chain-rule")), "p", f, after}};
  cur := after;
  su := SD'Diff(u, v);
  cur := SD'Merge(cur, su, "DPrime")[2];
  steps := Concat(steps, su[1]);
  {steps, cur};
];

10 # SD'Diff(Sin(_u), _v) <-- SD'FuncDiff("sin", Sin(u), Cos(u) * DPrime(u), u, v);
10 # SD'Diff(Cos(_u), _v) <-- SD'FuncDiff("cos", Cos(u), (-Sin(u)) * DPrime(u), u, v);
10 # SD'Diff(Exp(_u), _v) <-- SD'FuncDiff("exp", Exp(u), Exp(u) * DPrime(u), u, v);
10 # SD'Diff(Ln(_u), _v) <-- SD'FuncDiff("ln", Ln(u), DPrime(u) / u, u, v);
10 # SD'Diff(Sqrt(_u), _v) <-- SD'FuncDiff("sqrt", Sqrt(u), DPrime(u) / (2 * Sqrt(u)), u, v);

/* 三角(导数规范形:Tan 为 1/Cos^2)。注意 Cot/Sec/Csc 在引擎求值时
   即被规范化(1/Tan、1/Cos、1/Sin),不会作为函数实体进入本层,
   故不设规则 —— 商法则/幂规则会接管其组合形式。 */
10 # SD'Diff(Tan(_u), _v) <-- SD'FuncDiff("tan", Tan(u), DPrime(u) / Cos(u) ^ 2, u, v);

/* 反三角(ArcSin 为 1/Sqrt(1-u^2),ArcCos 带负号,ArcTan 为 1/(1+u^2)) */
10 # SD'Diff(ArcSin(_u), _v) <-- SD'FuncDiff("arcsin", ArcSin(u), DPrime(u) / Sqrt(1 - u ^ 2), u, v);
10 # SD'Diff(ArcCos(_u), _v) <-- SD'FuncDiff("arccos", ArcCos(u), (- DPrime(u)) / Sqrt(1 - u ^ 2), u, v);
10 # SD'Diff(ArcTan(_u), _v) <-- SD'FuncDiff("arctan", ArcTan(u), DPrime(u) / (1 + u ^ 2), u, v);

/* 双曲(Sinh 为 Cosh,Cosh 为 Sinh,Tanh 为 Sech^2) */
10 # SD'Diff(Sinh(_u), _v) <-- SD'FuncDiff("sinh", Sinh(u), Cosh(u) * DPrime(u), u, v);
10 # SD'Diff(Cosh(_u), _v) <-- SD'FuncDiff("cosh", Cosh(u), Sinh(u) * DPrime(u), u, v);
10 # SD'Diff(Tanh(_u), _v) <-- SD'FuncDiff("tanh", Tanh(u), Sech(u) ^ 2 * DPrime(u), u, v);

/* ============================================================
   积分步骤 StepsI(线性/幂/基本函数表/parts/u-substitution/兜底)
   ============================================================ */

StepsI(expr, var) :=
[
  Local(p, steps, tidied);
  p := SD'Merge(Int(expr), SI'Diff(expr, var), "Int");
  /* θ 机器的终式由精确 Subst 构造,已是成品;Tidy 的全量 Simplify
     对它实测 5s 仍是无操作,按链尾规则定向跳过 */
  If (p[1][Length(p[1])][1] = "back-sub-rule",
    tidied := p[2],
    tidied := Tidy(p[2]));
  If (tidied = p[2],
    steps := p[1],
    steps := Append(p[1], {"simplify", tidied}));
  steps;
];

/* 通用 u-substitution 机制:
   integrand = fam(g) * rest,rest = c * g'(常数倍);
   u = g,du = g' dx → ∫c*f(u) du,再回代 u → g。
   返回 {raw steps, final}。 */
SI'USub(integrand, g, fam, rest, v) :=
[
  Local(c, fu, cur, sub, steps);
  c := Simplify(rest / (Deriv(v) g));
  /* 精确结构替换:先 g^2 → u^2(覆盖 1/(g^2+1) 这类),再 g → u */
  fu := ApplyPure("Subst", {g ^ 2, u ^ 2, c * fam});
  fu := ApplyPure("Subst", {g, u, fu});
  If (fu = c * fam,
    /* 替换无进展:常数被规范型吸收后 g 已找不到(如 1/(2*u) 的 c*fam
       规范成 1/(4*u),2*u 不再是子项)。此时再对 fu 换元只会对自身
       输出无限递归(1/(2u)→1/(4u)→1/(16u)→...),改交引擎直积。 */
    {{{"direct", "p", integrand, Integrate(v) integrand}}, Integrate(v) integrand},
    [
      steps := {{"method-u-sub", "m", integrand, integrand},
                {"u-sub-rule", "p", integrand, Int(fu)}};
      cur := Int(fu);
      /* 原始步骤原样拼接;merge 只用于推进 cur(取其最终值) */
      sub := SI'Diff(fu, u);
      cur := SD'Merge(cur, sub, "Int")[2];
      steps := Concat(steps, sub[1]);
      /* 回代 u → g */
      steps := Append(steps, {"back-sub-rule", "s", u, g});
      {steps, ApplyPure("Subst", {u, g, cur})};
    ]);
];

/* 兜底(最先定义):常数 / 自变量 / 未知结构(引擎直接积分) */
10 # SI'Diff(_f, _v) <--
  If (IsFreeOf(v, f),
    {{{"const-integral-rule", "p", f, f * v}}, f * v},
    If (f = v,
      {{{"power-rule", "p", f, f ^ 2 / 2}}, f ^ 2 / 2},
      {{{"direct", "p", f, Integrate(v) f}}, Integrate(v) f}
    )
  );
/* ---------- 部分分式:∫P(v)/Q(v) dv —— 倒数第二 resort ----------
   有意定义在兜底之后(同优先级后定义先试,故本规则紧贴 direct 兜底
   之前尝试):只有 u-sub/parts/基本表/arctan 全部 declined 的 / 形题
   才会走到这里,谓词因此无需 Apart 预检 —— arctan/u-sub 题零除税。
   "分解是否有效"的判定在规则体内:Apart 原样返回(不可约分母)时
   按 direct 兜底语义出步骤,与 HEAD 行为完全一致。 */

/* 有理函数判定:引擎与脚本库均无 IsPolynomial 原语,自写递归判定。
   常数兜底用 IsFreeOf(Pi/Sqrt(2) 等无关系数也算常数);v 自身单独判定。 */
RuleBase("IsPoly'", {f, v});

/* 兜底最先定义(同优先级后定义胜出) */
10 # IsPoly'(_f, _v) <-- False;
10 # IsPoly'(_f, _v)_(IsFreeOf(v, f)) <-- True;
10 # IsPoly'(_f, _v)_(f = v) <-- True;
10 # IsPoly'(_f + _g, _v) <--
  If (IsPoly'(f, v) And IsPoly'(g, v), True, False);
10 # IsPoly'(_f - _g, _v) <--
  If (IsPoly'(f, v) And IsPoly'(g, v), True, False);
10 # IsPoly'(_f * _g, _v) <--
  If (IsPoly'(f, v) And IsPoly'(g, v), True, False);
10 # IsPoly'(_f / _g, _v)_(IsFreeOf(v, g)) <--
  IsPoly'(f, v);
10 # IsPoly'(_f ^ _n, _v)_(IsFreeOf(v, n)) <--
  IsPoly'(f, v);
10 # IsPoly'(-_f, _v) <-- IsPoly'(f, v);

SI'PartFrac(integrand, p, q, v) :=
[
  Local(decomp, cur, sub, steps);
  decomp := Apart(integrand, v);
  If (decomp = integrand,
    /* 分解无进展(不可约分母):交引擎直积 */
    {{{"direct", "p", integrand, Integrate(v) integrand}}, Integrate(v) integrand},
    [
      steps := {{"method-partial-fraction", "m", integrand, integrand},
                {"partial-fraction-rule", "p", integrand, Int(decomp)}};
      cur := Int(decomp);
      sub := SI'Diff(decomp, v);
      cur := SD'Merge(cur, sub, "Int")[2];
      steps := Concat(steps, sub[1]);
      {steps, cur};
    ]);
];

/* 分母次数 >= 2 才值得分解(线性分母由线性-ln 规则/u-sub 接管,
   也避免浅层 1/(2u) 形态触发 Apart)。 */
10 # SI'Diff(_p / _q, _v)_(IsPoly'(p, v) And IsPoly'(q, v) And Degree(q, v) >= 2) <--
  SI'PartFrac(p / q, p, q, v);


/* 和法则 */
10 # SI'Diff(_a + _b, _v) <--
[
  Local(steps, cur, p, sa, sb);
  steps := {{"sum-rule", "p", a + b, Int(a) + Int(b)}};
  cur := Int(a) + Int(b);
  sa := SI'Diff(a, v);
  cur := SD'Merge(cur, sa, "Int")[2];
  steps := Concat(steps, sa[1]);
  sb := SI'Diff(b, v);
  cur := SD'Merge(cur, sb, "Int")[2];
  steps := Concat(steps, sb[1]);
  {steps, cur};
];

/* 常数倍法则 */
10 # SI'Diff(_c * _f, _v)_(IsFreeOf(v, c)) <--
[
  Local(steps, cur, p, sf);
  steps := {{"constant-multiple-rule", "p", c * f, c * Int(f)}};
  cur := c * Int(f);
  sf := SI'Diff(f, v);
  cur := SD'Merge(cur, sf, "Int")[2];
  steps := Concat(steps, sf[1]);
  {steps, cur};
];

/* 分式:∫c/x dx = c*Ln(x) */
10 # SI'Diff(_c / _a, _v)_(IsFreeOf(v, c) And a = v) <--
  {{{"ln-rule", "p", c / a, c * Ln(a)}}, c * Ln(a)};

/* 一元负号:按常数倍 -1 处理 */
10 # SI'Diff(-_f, _v) <--
[
  Local(steps, cur, sf);
  steps := {{"constant-multiple-rule", "p", -f, -Int(f)}};
  cur := -Int(f);
  sf := SI'Diff(f, v);
  cur := SD'Merge(cur, sf, "Int")[2];
  steps := Concat(steps, sf[1]);
  {steps, cur};
];

/* arctan 族:∫c/(1+a^2) dv = c*ArcTan(a)(a = v 时;算法书 IntPureSquare 的教学化拆分)。
   注意 yacas 会把 1+a^2 重排为 a^2+1,故用顺序无关的 _d + _a^2 形式;
   d 限正数常数(负数/符号 a 交给部分分式或保持 direct)。 */
10 # SI'Diff(_c / (_a ^ 2 + _d), _v)_(d > 0 And IsFreeOf(v, c) And a = v) <--
  {{{"arctan-rule", "p", c / (a ^ 2 + d), (c / Sqrt(d)) * ArcTan(a / Sqrt(d))}},
   (c / Sqrt(d)) * ArcTan(a / Sqrt(d))};

/* 幂法则(含 n=-1 → Ln) */
10 # SI'Diff(_a ^ _b, _v)_(a = v And IsFreeOf(v, b)) <--
  If (b = -1,
    {{{"ln-rule", "p", a ^ b, Ln(a)}}, Ln(a)},
    {{{"power-rule", "p", a ^ b, a ^ (b + 1) / (b + 1)}}, a ^ (b + 1) / (b + 1)});

/* 基本函数(仅当参数恰为积分变量) */
10 # SI'Diff(Sin(_u), _v)_(u = v) <--
  {{{"sin-rule", "p", Sin(u), -Cos(u)}}, -Cos(u)};
10 # SI'Diff(Cos(_u), _v)_(u = v) <--
  {{{"cos-rule", "p", Cos(u), Sin(u)}}, Sin(u)};
10 # SI'Diff(Exp(_u), _v)_(u = v) <--
  {{{"exp-rule", "p", Exp(u), Exp(u)}}, Exp(u)};

/* 三角/双曲基本表(规范形与 integrate.rep 一致) */
10 # SI'Diff(Tan(_u), _v)_(u = v) <--
  {{{"tan-rule", "p", Tan(u), -Ln(Cos(u))}}, -Ln(Cos(u))};
10 # SI'Diff(Sinh(_u), _v)_(u = v) <--
  {{{"sinh-rule", "p", Sinh(u), Cosh(u)}}, Cosh(u)};
10 # SI'Diff(Cosh(_u), _v)_(u = v) <--
  {{{"cosh-rule", "p", Cosh(u), Sinh(u)}}, Sinh(u)};
10 # SI'Diff(Tanh(_u), _v)_(u = v) <--
  {{{"tanh-rule", "p", Tanh(u), Ln(Cosh(u))}}, Ln(Cosh(u))};

/* ---------- 幂约简递推:Sin^n / Cos^n(u = v,n 整数 >= 2) ----------
   ∫Sin^n u du = -(Sin^(n-1)u*Cosu)/n + ((n-1)/n)*∫Sin^(n-2)u du,
   ∫Cos^n u du 对称。每步显式展示,替代引擎 Integrate 的黑盒 direct;
   递推落到 n=1(具名函数规则)或 n=0(常数规则)。 */

SI'SinPow(n, u) :=
[
  Local(steps, cur, sf);
  steps := {{"power-reduction-rule", "p", Sin(u) ^ n,
             -(Sin(u) ^ (n - 1) * Cos(u)) / n + ((n - 1) / n) * Int(Sin(u) ^ (n - 2))}};
  cur := -(Sin(u) ^ (n - 1) * Cos(u)) / n + ((n - 1) / n) * Int(Sin(u) ^ (n - 2));
  sf := SI'Diff(Sin(u) ^ (n - 2), u);
  cur := SD'Merge(cur, sf, "Int")[2];
  steps := Concat(steps, sf[1]);
  {steps, cur};
];

SI'CosPow(n, u) :=
[
  Local(steps, cur, sf);
  steps := {{"power-reduction-rule", "p", Cos(u) ^ n,
             (Cos(u) ^ (n - 1) * Sin(u)) / n + ((n - 1) / n) * Int(Cos(u) ^ (n - 2))}};
  cur := (Cos(u) ^ (n - 1) * Sin(u)) / n + ((n - 1) / n) * Int(Cos(u) ^ (n - 2));
  sf := SI'Diff(Cos(u) ^ (n - 2), u);
  cur := SD'Merge(cur, sf, "Int")[2];
  steps := Concat(steps, sf[1]);
  {steps, cur};
];

10 # SI'Diff(Sin(_u) ^ _n, _v)_(u = v And IsInteger(n) And n >= 2) <--
  SI'SinPow(n, u);
10 # SI'Diff(Cos(_u) ^ _n, _v)_(u = v And IsInteger(n) And n >= 2) <--
  SI'CosPow(n, u);

/* 反正弦形:∫c/Sqrt(d - v^2) dv = c*ArcSin(v/Sqrt(d))(d 为正数常数;
   一般化自 d=1 特例)。 */
10 # SI'Diff(_c / Sqrt(_d - _a ^ 2), _v)_(d > 0 And IsFreeOf(v, c) And a = v) <--
  {{{"arcsin-rule", "p", c / Sqrt(d - a ^ 2), c * ArcSin(a / Sqrt(d))}},
   c * ArcSin(a / Sqrt(d))};

/* 平方和/差开方形式:∫c/Sqrt(v^2 ± d) dv = c*Ln(v + Sqrt(v^2 ± d))
   (引擎 Integrate 不支持此形,由本规则直接给出;求导可自验:
   d/dv Ln(v+Sqrt(v^2+d)) = 1/Sqrt(v^2+d)) */
10 # SI'Diff(_c / Sqrt(_a ^ 2 + _d), _v)_(d > 0 And IsFreeOf(v, c) And a = v) <--
  {{{"sqrt-sum-rule", "p", c / Sqrt(a ^ 2 + d), c * Ln(a + Sqrt(a ^ 2 + d))}},
   c * Ln(a + Sqrt(a ^ 2 + d))};
10 # SI'Diff(_c / Sqrt(_a ^ 2 - _d), _v)_(d > 0 And IsFreeOf(v, c) And a = v) <--
  {{{"sqrt-diff-rule", "p", c / Sqrt(a ^ 2 - d), c * Ln(a + Sqrt(a ^ 2 - d))}},
   c * Ln(a + Sqrt(a ^ 2 - d))};

/* 平方根本身:∫c/Sqrt(v) dv = 2c*Sqrt(v)(幂法则 n = -1/2) */
10 # SI'Diff(_c / Sqrt(_a), _v)_(a = v) <--
  {{{"power-rule", "p", c / Sqrt(a), 2 * c * Sqrt(a)}}, 2 * c * Sqrt(a)};

/* ---------- 分部积分:∫u*dv = u*v - ∫v*du(u 按 LIATE 选取,dv = 其余因子) ---------- */

SI'Parts(integrand, u, dvf, vval, var) :=
[
  Local(du, cur, sub, steps);
  du := Deriv(var) u;
  steps := {{"method-parts", "m", integrand, integrand},
            {"parts-rule", "p", integrand, u * vval - Int(vval * du)}};
  cur := u * vval - Int(vval * du);
  /* 残差先 Tidy,便于下一步规则匹配 */
  sub := SI'Diff(Tidy(vval * du), var);
  cur := SD'Merge(cur, sub, "Int")[2];
  steps := Concat(steps, sub[1]);
  {steps, cur};
];

/* Ln 单独:∫Ln(v) dv = v*Ln(v) - v */
10 # SI'Diff(Ln(_g), _v)_(g = v) <--
  SI'Parts(Ln(g), Ln(g), 1, v, v);

/* Ln × 其余:u = Ln(g)(LIATE 对数优先) */
10 # SI'Diff(Ln(_g) * _rest, _v) <--
  SI'Parts(Ln(g) * rest, Ln(g), rest, Integrate(v) rest, v);
10 # SI'Diff(_rest * Ln(_g), _v) <--
  SI'Parts(rest * Ln(g), Ln(g), rest, Integrate(v) rest, v);

/* 代数 × 三角/指数:u = a(a = v) */
10 # SI'Diff(_a * Sin(_g), _v)_(a = v And Not(IsFreeOf(v, Simplify(a / (Deriv(v) g))))) <--
  SI'Parts(a * Sin(g), a, Sin(g), Integrate(v) Sin(g), v);
10 # SI'Diff(_a * Cos(_g), _v)_(a = v And Not(IsFreeOf(v, Simplify(a / (Deriv(v) g))))) <--
  SI'Parts(a * Cos(g), a, Cos(g), Integrate(v) Cos(g), v);
10 # SI'Diff(_a * Exp(_g), _v)_(a = v And Not(IsFreeOf(v, Simplify(a / (Deriv(v) g))))) <--
  SI'Parts(a * Exp(g), a, Exp(g), Integrate(v) Exp(g), v);
10 # SI'Diff(Sin(_g) * _a, _v)_(a = v And Not(IsFreeOf(v, Simplify(a / (Deriv(v) g))))) <--
  SI'Parts(Sin(g) * a, a, Sin(g), Integrate(v) Sin(g), v);
10 # SI'Diff(Cos(_g) * _a, _v)_(a = v And Not(IsFreeOf(v, Simplify(a / (Deriv(v) g))))) <--
  SI'Parts(Cos(g) * a, a, Cos(g), Integrate(v) Cos(g), v);
10 # SI'Diff(Exp(_g) * _a, _v)_(a = v And Not(IsFreeOf(v, Simplify(a / (Deriv(v) g))))) <--
  SI'Parts(Exp(g) * a, a, Exp(g), Integrate(v) Exp(g), v);

/* 幂 × 三角/指数:u = a^n */
10 # SI'Diff(_a ^ _n * Sin(_g), _v)_(IsFreeOf(v, n) And a = v) <--
  SI'Parts(a ^ n * Sin(g), a ^ n, Sin(g), Integrate(v) Sin(g), v);
10 # SI'Diff(_a ^ _n * Cos(_g), _v)_(IsFreeOf(v, n) And a = v) <--
  SI'Parts(a ^ n * Cos(g), a ^ n, Cos(g), Integrate(v) Cos(g), v);
10 # SI'Diff(_a ^ _n * Exp(_g), _v)_(IsFreeOf(v, n) And a = v) <--
  SI'Parts(a ^ n * Exp(g), a ^ n, Exp(g), Integrate(v) Exp(g), v);

/* ---------- u-substitution:带 rest 因子(∫ fam(g) * rest dx,rest = c*g') ---------- */

10 # SI'Diff(Sin(_g) * _rest, _v)_(Not(g = v) And Not(IsFreeOf(v, g)) And IsFreeOf(v, Simplify(rest / (Deriv(v) g)))) <--
  SI'USub(Sin(g) * rest, g, Sin(g), rest, v);
10 # SI'Diff(Cos(_g) * _rest, _v)_(Not(g = v) And Not(IsFreeOf(v, g)) And IsFreeOf(v, Simplify(rest / (Deriv(v) g)))) <--
  SI'USub(Cos(g) * rest, g, Cos(g), rest, v);
10 # SI'Diff(Exp(_g) * _rest, _v)_(Not(g = v) And Not(IsFreeOf(v, g)) And IsFreeOf(v, Simplify(rest / (Deriv(v) g)))) <--
  SI'USub(Exp(g) * rest, g, Exp(g), rest, v);
10 # SI'Diff(Tan(_g) * _rest, _v)_(Not(g = v) And Not(IsFreeOf(v, g)) And IsFreeOf(v, Simplify(rest / (Deriv(v) g)))) <--
  SI'USub(Tan(g) * rest, g, Tan(g), rest, v);
10 # SI'Diff(Sinh(_g) * _rest, _v)_(Not(g = v) And Not(IsFreeOf(v, g)) And IsFreeOf(v, Simplify(rest / (Deriv(v) g)))) <--
  SI'USub(Sinh(g) * rest, g, Sinh(g), rest, v);
10 # SI'Diff(Cosh(_g) * _rest, _v)_(Not(g = v) And Not(IsFreeOf(v, g)) And IsFreeOf(v, Simplify(rest / (Deriv(v) g)))) <--
  SI'USub(Cosh(g) * rest, g, Cosh(g), rest, v);
10 # SI'Diff(Tanh(_g) * _rest, _v)_(Not(g = v) And Not(IsFreeOf(v, g)) And IsFreeOf(v, Simplify(rest / (Deriv(v) g)))) <--
  SI'USub(Tanh(g) * rest, g, Tanh(g), rest, v);
10 # SI'Diff(_g ^ _n * _rest, _v)_(Not(g = v) And IsFreeOf(v, n) And Not(IsFreeOf(v, g)) And IsFreeOf(v, Simplify(rest / (Deriv(v) g)))) <--
  SI'USub(g ^ n * rest, g, g ^ n, rest, v);
10 # SI'Diff(_rest / _g, _v)_(Not(g = v) And Not(IsFreeOf(v, g)) And IsFreeOf(v, Simplify(rest / (Deriv(v) g)))) <--
  SI'USub(rest / g, g, 1 / g, rest, v);
10 # SI'Diff(_rest / (_g ^ 2 + _d), _v)_(d = 1 And Not(g = v) And Not(IsFreeOf(v, g)) And IsFreeOf(v, Simplify(rest / (Deriv(v) g)))) <--
  SI'USub(rest / (g ^ 2 + d), g, 1 / (g ^ 2 + d), rest, v);

/* ---------- u-substitution:无 rest 因子(∫ fam(g) dx,g' 为常数) ---------- */

10 # SI'Diff(Sin(_g), _v)_(Not(g = v) And Not(IsFreeOf(v, g)) And IsFreeOf(v, Simplify(1 / (Deriv(v) g)))) <--
  SI'USub(Sin(g), g, Sin(g), 1, v);
10 # SI'Diff(Cos(_g), _v)_(Not(g = v) And Not(IsFreeOf(v, g)) And IsFreeOf(v, Simplify(1 / (Deriv(v) g)))) <--
  SI'USub(Cos(g), g, Cos(g), 1, v);
10 # SI'Diff(Exp(_g), _v)_(Not(g = v) And Not(IsFreeOf(v, g)) And IsFreeOf(v, Simplify(1 / (Deriv(v) g)))) <--
  SI'USub(Exp(g), g, Exp(g), 1, v);
10 # SI'Diff(Tan(_g), _v)_(Not(g = v) And Not(IsFreeOf(v, g)) And IsFreeOf(v, Simplify(1 / (Deriv(v) g)))) <--
  SI'USub(Tan(g), g, Tan(g), 1, v);
10 # SI'Diff(Sinh(_g), _v)_(Not(g = v) And Not(IsFreeOf(v, g)) And IsFreeOf(v, Simplify(1 / (Deriv(v) g)))) <--
  SI'USub(Sinh(g), g, Sinh(g), 1, v);
10 # SI'Diff(Cosh(_g), _v)_(Not(g = v) And Not(IsFreeOf(v, g)) And IsFreeOf(v, Simplify(1 / (Deriv(v) g)))) <--
  SI'USub(Cosh(g), g, Cosh(g), 1, v);
10 # SI'Diff(Tanh(_g), _v)_(Not(g = v) And Not(IsFreeOf(v, g)) And IsFreeOf(v, Simplify(1 / (Deriv(v) g)))) <--
  SI'USub(Tanh(g), g, Tanh(g), 1, v);
10 # SI'Diff(_g ^ _n, _v)_(IsFreeOf(v, n) And Not(g = v) And Not(IsFreeOf(v, g)) And IsFreeOf(v, Simplify(1 / (Deriv(v) g)))) <--
  SI'USub(g ^ n, g, g ^ n, 1, v);

/* ---------- u-substitution:反向因子顺序(rest * fam(g),rest = c*g') ---------- */

10 # SI'Diff(_rest * Sin(_g), _v)_(Not(g = v) And Not(IsFreeOf(v, g)) And IsFreeOf(v, Simplify(rest / (Deriv(v) g)))) <--
  SI'USub(rest * Sin(g), g, Sin(g), rest, v);
10 # SI'Diff(_rest * Cos(_g), _v)_(Not(g = v) And Not(IsFreeOf(v, g)) And IsFreeOf(v, Simplify(rest / (Deriv(v) g)))) <--
  SI'USub(rest * Cos(g), g, Cos(g), rest, v);
10 # SI'Diff(_rest * Exp(_g), _v)_(Not(g = v) And Not(IsFreeOf(v, g)) And IsFreeOf(v, Simplify(rest / (Deriv(v) g)))) <--
  SI'USub(rest * Exp(g), g, Exp(g), rest, v);
10 # SI'Diff(_rest * Tan(_g), _v)_(Not(g = v) And Not(IsFreeOf(v, g)) And IsFreeOf(v, Simplify(rest / (Deriv(v) g)))) <--
  SI'USub(rest * Tan(g), g, Tan(g), rest, v);
10 # SI'Diff(_rest * Sinh(_g), _v)_(Not(g = v) And Not(IsFreeOf(v, g)) And IsFreeOf(v, Simplify(rest / (Deriv(v) g)))) <--
  SI'USub(rest * Sinh(g), g, Sinh(g), rest, v);
10 # SI'Diff(_rest * Cosh(_g), _v)_(Not(g = v) And Not(IsFreeOf(v, g)) And IsFreeOf(v, Simplify(rest / (Deriv(v) g)))) <--
  SI'USub(rest * Cosh(g), g, Cosh(g), rest, v);
10 # SI'Diff(_rest * Tanh(_g), _v)_(Not(g = v) And Not(IsFreeOf(v, g)) And IsFreeOf(v, Simplify(rest / (Deriv(v) g)))) <--
  SI'USub(rest * Tanh(g), g, Tanh(g), rest, v);
10 # SI'Diff(_rest * _g ^ _n, _v)_(Not(g = v) And IsFreeOf(v, n) And Not(IsFreeOf(v, g)) And IsFreeOf(v, Simplify(rest / (Deriv(v) g)))) <--
  SI'USub(rest * g ^ n, g, g ^ n, rest, v);


/* 线性分母:∫c/(a*v+b) dv = (c/a)*Ln(a*v+b),斜率取 Deriv(v)l(免展开依赖)。
   定义在 u-sub 之后(先于 u-sub 尝试):部分分式的 A/(x-a) 项由此直接
   接住,不再绕道 u-sub;深层 1/(2u) 形态也不再触发无进展守卫。
   l = v(即 c/x)留给既有的 ln-rule,本规则不接。 */
10 # SI'Diff(_c / _l, _v)_(IsPoly'(l, v) And Not(l = v) And IsFreeOf(v, c) And Degree(l, v) = 1) <--
  {{{"ln-rule", "p", c / l, (c / Deriv(v) l) * Ln(l)}}, (c / Deriv(v) l) * Ln(l)};

/* 平方根复合:∫rest/Sqrt(g) dv = 2k*Sqrt(g),k = rest/g' 为常数
   (即幂法则 n = -1/2 的复合一步式;∫x/Sqrt(x^2+a^2) 类由此接住,
   引擎对它本无解析路径) */
10 # SI'Diff(_rest / Sqrt(_g), _v)_(Not(g = v) And Not(IsFreeOf(v, g)) And IsFreeOf(v, Simplify(rest / (Deriv(v) g)))) <--
  {{{"power-rule", "p", rest / Sqrt(g), 2 * (rest / (Deriv(v) g)) * Sqrt(g)}},
   2 * (rest / (Deriv(v) g)) * Sqrt(g)};

/* 常数除法因子:∫f/c dv = (1/c)*∫f dv(分母为常数的除法形态;
   u-sub 内层的 Sin(u)/2 之类由此进入具名步骤而非 direct。
   谓词 IsFreeOf(v, c) 与线性-ln/ln 规则按分母形态自然分工) */
10 # SI'Diff(_f / _c, _v)_(IsFreeOf(v, c)) <--
[
  Local(steps, cur, sf);
  steps := {{"constant-multiple-rule", "p", f / c, Int(f) / c}};
  cur := Int(f) / c;
  sf := SI'Diff(f, v);
  cur := SD'Merge(cur, sf, "Int")[2];
  steps := Concat(steps, sf[1]);
  {steps, cur};
];

/* ---------- 三角换元 θ 机器(M2c:sin 形式,Sqrt(d - v^2)) ----------
   被积式含 Sqrt(d - v^2)(d 正数常数)且裸形规则未接住时:
   v = Sqrt(d)*Sin(theta)。整条管线先静默算通,回代后验"无 theta 残留、
   无 Integrate 泄漏"才提交;失败(如 R 次数过高产生 Sin(4*theta))
   自动回落 direct,绝不输出半成品。
   双倍角/三倍角展开由恒等表承担(覆盖 R 次数 <= 2 的 theta 域
   反导数词汇表)。注意:换元哑元名不得与 SD'Merge 的局部变量
   (t 等)冲突,故用 theta。 */

/* 恒等式表只构建一次(实测每次重建约 1s,θ 流程要调两次) */
SI'TrigIdTable := {};

SI'TrigIdentity() :=
[
  If (Length(SI'TrigIdTable) = 0,
    SI'TrigIdTable := {{Sin(2 * theta), 2 * Sin(theta) * Cos(theta)},
   {Sin((-2) * theta), -(2 * Sin(theta) * Cos(theta))},
   {Cos(2 * theta), 2 * Cos(theta) ^ 2 - 1},
   {Cos((-2) * theta), 2 * Cos(theta) ^ 2 - 1},
   {Sin(3 * theta), 3 * Sin(theta) - 4 * Sin(theta) ^ 3},
   {Sin((-3) * theta), -(3 * Sin(theta) - 4 * Sin(theta) ^ 3)},
   {Cos(3 * theta), 4 * Cos(theta) ^ 3 - 3 * Cos(theta)},
   {Cos((-3) * theta), 4 * Cos(theta) ^ 3 - 3 * Cos(theta)},
   {Sin(4 * theta), 4 * Sin(theta) * Cos(theta) * (2 * Cos(theta) ^ 2 - 1)},
   {Sin((-4) * theta), -(4 * Sin(theta) * Cos(theta) * (2 * Cos(theta) ^ 2 - 1))},
   {Cos(4 * theta), 8 * Cos(theta) ^ 4 - 8 * Cos(theta) ^ 2 + 1},
   {Cos((-4) * theta), 8 * Cos(theta) ^ 4 - 8 * Cos(theta) ^ 2 + 1}});
  SI'TrigIdTable;
];

SI'TrigSub(integrand, v, d) :=
[
  Local(substv, jac, radpattern, tform, sub, cur, pre, steps, final, id, ids);
  substv := Sqrt(d) * Sin(theta);
  /* 雅可比对换元变量 theta 求(Deriv(v) 是概念错误:substv 中已无 v) */
  jac := Deriv(theta) substv;
  tform := ApplyPure("Subst", {v, substv, integrand}) * jac;
  /* 根式重写:Sqrt(d - (Sqrt(d)*Sin(theta))^2) = Sqrt(d)*Cos(theta)
     (theta ∈ (-pi/2, pi/2) 教科书约定;引擎 Simplify 不做此事,
     由换元数据按精确规范形 Subst) */
  radpattern := ApplyPure("Subst", {v, substv, Sqrt(d - v ^ 2)});
  tform := ApplyPure("Subst", {radpattern, Sqrt(d) * Cos(theta), tform});
  /* 约简 theta 形态(如 ((2Sin)^2*2Cos)/(2Cos) -> 4*Sin(theta)^2) */
  tform := Simplify(tform);
  /* theta 域积分(静默) */
  sub := SI'Diff(tform, theta);
  cur := sub[2];
  /* 静默回代:恒等展开 -> 三角形 -> 裸 theta;
     pre 留作发射判据(发射循环看到的是已转换的 cur) */
  pre := cur;
  ids := SI'TrigIdentity();
  ForEach(id, ids)
    If (Not(IsFreeOf(id[1], cur)),
      cur := ApplyPure("Subst", {id[1], id[2], cur}));
  cur := ApplyPure("Subst", {Sin(theta), v / Sqrt(d), cur});
  cur := ApplyPure("Subst", {Cos(theta), Sqrt(d - v ^ 2) / Sqrt(d), cur});
  final := ApplyPure("Subst", {theta, ArcSin(v / Sqrt(d)), cur});
  /* 提交门禁:theta 消净且无 Integrate 泄漏 */
  If (IsFreeOf(theta, final) And IsFreeOf(Integrate, final),
    [
      steps := {{"method-trig-sub", "m", integrand, integrand},
                {"trig-sub-rule", "p", integrand, Int(tform)}};
      /* 复用静默阶段的 theta 域原始步骤(求值确定性),不重跑 */
      steps := Concat(steps, sub[1]);
      ForEach(id, ids)
        If (Not(IsFreeOf(id[1], pre)),
          steps := Append(steps, {"trig-identity-rule", "s", id[1], id[2]}));
      steps := Append(steps, {"trig-sub-back", "s", Sin(theta), v / Sqrt(d)});
      steps := Append(steps, {"trig-sub-back", "s", Cos(theta), Sqrt(d - v ^ 2) / Sqrt(d)});
      steps := Append(steps, {"back-sub-rule", "s", theta, ArcSin(v / Sqrt(d))});
      /* final 用静默阶段已过门禁的结果(与步骤序列的 Subst 链一致) */
      {steps, final};
    ],
    {{{"direct", "p", integrand, Integrate(v) integrand}}, Integrate(v) integrand});
];

/* 触发:被积式含 Sqrt(d - v^2) 且 R 为不含根式的 v 多项式;
   f 为纯常数时让位给 arcsin-rule 裸形(一步更简洁) */
10 # SI'Diff(Sqrt(_d - _v ^ 2), _v)_(d > 0) <--
  SI'TrigSub(Sqrt(d - v ^ 2), v, d);
/* IsFreeOf(theta, f):用户积分式含 theta 时让位 direct(换元哑元防冲突) */
10 # SI'Diff(_f / Sqrt(_d - _v ^ 2), _v)_(d > 0 And IsPoly'(f, v) And IsFreeOf(Sqrt(d - v ^ 2), f) And Not(IsFreeOf(v, f)) And IsFreeOf(theta, f)) <--
  SI'TrigSub(f / Sqrt(d - v ^ 2), v, d);
10 # SI'Diff(_f * Sqrt(_d - _v ^ 2), _v)_(d > 0 And IsPoly'(f, v) And IsFreeOf(Sqrt(d - v ^ 2), f) And IsFreeOf(theta, f)) <--
  SI'TrigSub(f * Sqrt(d - v ^ 2), v, d);
10 # SI'Diff(Sqrt(_d - _v ^ 2) * _f, _v)_(d > 0 And IsPoly'(f, v) And IsFreeOf(Sqrt(d - v ^ 2), f) And IsFreeOf(theta, f)) <--
  SI'TrigSub(Sqrt(d - v ^ 2) * f, v, d);

/* ============================================================
   解释文案(声明式):数据表 + 查询。

/* ============================================================
   解释文案(声明式):数据表 + 查询。
   风格约定:陈述规则本身(公式/操作),不做教学解说
   ("为什么"留白给使用者)—— 与 PLAN §6 的"数据驱动"一致。
   记法:撇号 = 对积分/求导变量求导;积分公式中 x 泛指积分变量。
   侧感知:同一规则键在求导/积分两侧语义不同(power-rule 在两侧
   是两条公式),积分侧用 "i:" 前缀键覆盖,由 Steps'ExplainFor
   先查侧键、未登记再回退通用键;仅单侧使用的规则直接登记通用键。
   ============================================================ */

/* 数据即规则:每条文案 = 一条 10 # 规则(声明式数据表),
   兜底规则(最前定义)负责未登记键 → ""。
   注意:1.9.2 中 Return 在 For 循环体内不生效(踩坑验证),
   故查询走规则系统而非循环遍历。 */
RuleBase("Steps'Text", {key});

/* 兜底必须定义在最前(同优先级后定义胜出,§7.2.2) */
10 # Steps'Text(_key) <-- "";

/* ---------- 求导侧(通用键默认即求导语义) ---------- */
10 # Steps'Text("const-rule") <-- "常数法则: c' = 0";
10 # Steps'Text("identity-rule") <-- "自变量法则: x' = 1";
10 # Steps'Text("d:direct") <-- "直接求导";
10 # Steps'Text("constant-multiple-rule") <-- "常数倍法则: (c*u)' = c*u'";
10 # Steps'Text("sum-rule") <-- "和法则: (f + g)' = f' + g'";
10 # Steps'Text("product-rule") <-- "积法则: (f*g)' = f'*g + f*g'";
10 # Steps'Text("quotient-rule") <-- "商法则: (f/g)' = (f'*g - f*g')/g^2";
10 # Steps'Text("power-rule") <-- "幂法则: (u^n)' = n*u^(n-1)*u'";
10 # Steps'Text("exponential-rule") <-- "指数法则: (a^u)' = a^u*Ln(a)*u'";
10 # Steps'Text("sin-rule") <-- "正弦法则: (Sin(u))' = Cos(u)*u'";
10 # Steps'Text("cos-rule") <-- "余弦法则: (Cos(u))' = -Sin(u)*u'";
10 # Steps'Text("exp-rule") <-- "自然指数法则: (Exp(u))' = Exp(u)*u'";
10 # Steps'Text("ln-rule") <-- "对数法则: (Ln(u))' = u'/u";
10 # Steps'Text("sqrt-rule") <-- "平方根法则: (Sqrt(u))' = u'/(2*Sqrt(u))";

/* 三角/反三角/双曲(M1 新增;规范形与 deriv.rep 一致,Tanh 以引擎规范型 1/Cosh^2 表述) */
10 # Steps'Text("tan-rule") <-- "正切法则: (Tan(u))' = u'/Cos(u)^2";
10 # Steps'Text("arcsin-rule") <-- "反正弦法则: (ArcSin(u))' = u'/Sqrt(1 - u^2)";
10 # Steps'Text("arccos-rule") <-- "反余弦法则: (ArcCos(u))' = -u'/Sqrt(1 - u^2)";
10 # Steps'Text("arctan-rule") <-- "反正切法则: (ArcTan(u))' = u'/(1 + u^2)";
10 # Steps'Text("sinh-rule") <-- "双曲正弦法则: (Sinh(u))' = Cosh(u)*u'";
10 # Steps'Text("cosh-rule") <-- "双曲余弦法则: (Cosh(u))' = Sinh(u)*u'";
10 # Steps'Text("tanh-rule") <-- "双曲正切法则: (Tanh(u))' = 1/Cosh(u)^2";

/* 链式法则键:复合参数由 SD'FuncDiff 登记 "<name>-chain-rule",
   文案 = 链式法则标记 + 同一外层公式(u' 为待定内层导数) */
10 # Steps'Text("sin-chain-rule") <-- "链式法则: (Sin(u))' = Cos(u)*u'";
10 # Steps'Text("cos-chain-rule") <-- "链式法则: (Cos(u))' = -Sin(u)*u'";
10 # Steps'Text("exp-chain-rule") <-- "链式法则: (Exp(u))' = Exp(u)*u'";
10 # Steps'Text("ln-chain-rule") <-- "链式法则: (Ln(u))' = u'/u";
10 # Steps'Text("sqrt-chain-rule") <-- "链式法则: (Sqrt(u))' = u'/(2*Sqrt(u))";
10 # Steps'Text("power-chain-rule") <-- "链式法则: (u^n)' = n*u^(n-1)*u'";
10 # Steps'Text("exponential-chain-rule") <-- "链式法则: (a^u)' = a^u*Ln(a)*u'";
10 # Steps'Text("tan-chain-rule") <-- "链式法则: (Tan(u))' = u'/Cos(u)^2";
10 # Steps'Text("arcsin-chain-rule") <-- "链式法则: (ArcSin(u))' = u'/Sqrt(1 - u^2)";
10 # Steps'Text("arccos-chain-rule") <-- "链式法则: (ArcCos(u))' = -u'/Sqrt(1 - u^2)";
10 # Steps'Text("arctan-chain-rule") <-- "链式法则: (ArcTan(u))' = u'/(1 + u^2)";
10 # Steps'Text("sinh-chain-rule") <-- "链式法则: (Sinh(u))' = Cosh(u)*u'";
10 # Steps'Text("cosh-chain-rule") <-- "链式法则: (Cosh(u))' = Sinh(u)*u'";
10 # Steps'Text("tanh-chain-rule") <-- "链式法则: (Tanh(u))' = 1/Cosh(u)^2";

/* ---------- 积分侧覆盖("i:" 前缀) ---------- */
10 # Steps'Text("direct") <-- "直接求导";
10 # Steps'Text("i:direct") <-- "直接积分";
10 # Steps'Text("i:constant-multiple-rule") <-- "常数倍法则: ∫c*f dx = c*∫f dx";
10 # Steps'Text("i:sum-rule") <-- "和法则: ∫(f + g) dx = ∫f dx + ∫g dx";
10 # Steps'Text("i:power-rule") <-- "幂法则: ∫x^n dx = x^(n+1)/(n + 1) (n ≠ -1)";
10 # Steps'Text("i:ln-rule") <-- "对数积分: ∫c/(a*x + b) dx = (c/a)*Ln(a*x + b)";
10 # Steps'Text("i:sin-rule") <-- "正弦积分: ∫Sin(x) dx = -Cos(x)";
10 # Steps'Text("i:cos-rule") <-- "余弦积分: ∫Cos(x) dx = Sin(x)";
10 # Steps'Text("i:exp-rule") <-- "自然指数积分: ∫Exp(x) dx = Exp(x)";

/* ---------- 仅积分侧使用的规则(通用键) ---------- */
10 # Steps'Text("const-integral-rule") <-- "常数积分: ∫c dx = c*x";
10 # Steps'Text("i:tan-rule") <-- "正切积分: ∫Tan(x) dx = -Ln(Cos(x))";
10 # Steps'Text("i:sinh-rule") <-- "双曲正弦积分: ∫Sinh(x) dx = Cosh(x)";
10 # Steps'Text("i:cosh-rule") <-- "双曲余弦积分: ∫Cosh(x) dx = Sinh(x)";
10 # Steps'Text("i:tanh-rule") <-- "双曲正切积分: ∫Tanh(x) dx = Ln(Cosh(x))";
10 # Steps'Text("i:arctan-rule") <-- "反正切积分: ∫c/(x^2 + a^2) dx = (c/a)*ArcTan(x/a)";
10 # Steps'Text("i:arcsin-rule") <-- "反正弦积分: ∫c/Sqrt(a^2 - x^2) dx = c*ArcSin(x/a)";
10 # Steps'Text("sqrt-sum-rule") <-- "平方和开方: ∫c/Sqrt(x^2 + a^2) dx = c*Ln(x + Sqrt(x^2 + a^2))";
10 # Steps'Text("sqrt-diff-rule") <-- "平方差开方: ∫c/Sqrt(x^2 - a^2) dx = c*Ln(x + Sqrt(x^2 - a^2))";
10 # Steps'Text("u-sub-rule") <-- "换元: u = g(x), du = g'(x) dx";
10 # Steps'Text("back-sub-rule") <-- "回代: u → g(x)";
10 # Steps'Text("parts-rule") <-- "分部积分: ∫u dv = u*v - ∫v du";
10 # Steps'Text("partial-fraction-rule") <-- "部分分式: P/Q 分解为最简分式之和,逐项积分";

/* 方法横幅(M2b):多步策略的第一步,宣告所用方法 */
10 # Steps'Text("method-u-sub") <-- "方法: 换元积分法";
10 # Steps'Text("method-parts") <-- "方法: 分部积分法";
10 # Steps'Text("method-partial-fraction") <-- "方法: 部分分式积分法";
10 # Steps'Text("method-trig-sub") <-- "方法: 三角换元";
10 # Steps'Text("trig-sub-rule") <-- "三角换元: x = Sqrt(a)*Sin(theta), dx = Sqrt(a)*Cos(theta) dt, Sqrt(a^2 - x^2) = Sqrt(a)*Cos(theta)";
10 # Steps'Text("trig-identity-rule") <-- "三角恒等展开";
10 # Steps'Text("power-reduction-rule") <-- "幂约简递推: ∫Sin^n(u) du = -(Sin^(n-1)(u)*Cos(u))/n + ((n-1)/n)*∫Sin^(n-2)(u) du (Cos^n 对称)";
10 # Steps'Text("trig-sub-back") <-- "三角回代: Sin(theta) = x/Sqrt(a), Cos(theta) = Sqrt(a^2 - x^2)/Sqrt(a)";

/* ---------- 两侧通用 ---------- */
10 # Steps'Text("simplify") <-- "化简";

/* 查询入口:未登记键由兜底规则返回 ""(前端回退到规则键本身) */
Steps'Explain(key) := Steps'Text(key);

/* 侧感知查询:先查 "side:key"(side = "d"/"i"),未登记回退通用键 */
Steps'ExplainFor(key, side) :=
[
  Local(t);
  t := Steps'Text(ConcatStrings(side, ":", key));
  If (t = "", Steps'Text(key), t);
];

/* Full 变体:步骤三元组 {规则, 表达式, 文案},一次调用取齐渲染素材。
   原 StepsD/StepsI 的二元组契约不变(steps.yts 兼容)。 */
Steps'Annotate(steps, side) :=
[
  Local(i, s, out);
  out := {};
  For (i := 1, i <= Length(steps), i++)
  [
    s := steps[i];
    out := Append(out, {s[1], s[2], Steps'ExplainFor(s[1], side)});
  ];
  out;
];

StepsD'Full(expr, var) := Steps'Annotate(StepsD(expr, var), "d");

/* 高阶导数:对每一阶把上一轮化简后的最终表达式再走一遍完整步骤生成,
   步骤序列按轮拼接(第 k 轮的步骤即"对 k-1 阶导数再求导"的过程)。 */
StepsD'Full(expr, var, order) :=
[
  Local(cur, out, i, steps);
  cur := expr;
  out := {};
  For (i := 1, i <= order, i++)
  [
    steps := Steps'Annotate(StepsD(cur, var), "d");
    out := Concat(out, steps);
    cur := steps[Length(steps)][2];
  ];
  out;
];
StepsI'Full(expr, var) := Steps'Annotate(StepsI(expr, var), "i");

/* ---------- DPrime 占位符的 TeX 形态 ----------
   DPrime(t) 是 SD'Merge 的"待定内层导数"占位符;渲染为撇号记法 (t)',
   避免 GUI 显示 \mathrm{DPrime}。优先级 100 先于 texform.rep 的未知函数
   兜底(220)。texform.rep 经 packages.ys 懒加载,这里先 Use 显式装载
   (已装载则跳过),再登记规则。 */
Use("texform.rep/code.ys");
100 # TeXForm(DPrime(_x), _p) <-- ConcatStrings("\\left(", TeXForm(x, TeXFormMaxPrec()), "\\right)'");